# Custom Functions
# ----------------
# Find process ID of process using given port (usage: find-process-id-on-port 3000)
findport() {
  if [ $# -ne 1 ]; then
    echo "Usage: fport <port-number-to-search>"
    return 1
  fi
  lsof -i :$1
}
alias find-port="findport"
alias fp="findport"
alias fport="findport"
# Kill process ID of process using given port (usage: kill-process-on-port 3000)
killport() {
  if [ $# -ne 1 ]; then
    echo "Usage: kport <port-number-to-free>"
    return 1
  fi
  if [ -z "$(lsof -t -i:$1)" ]; then
    echo -e "NO process is using port: \033[1;32m$1\033[0m"
    return 1
  fi
  kill -9 $(lsof -t -i:$1)
}
# alias kpo="kport" # Note: This CONFLICTS with kpo == k get po
alias kill-port="killport"
alias kport="killport"
alias freep="killport"
alias freepo="killport"
alias freeport="killport"
# Kill given process id PID (usage: kp 1234)
killpid() {
  if [ $# -ne 1 ]; then
    echo "Usage: kpid <pid-to-kill>"
    return 1
  fi
  kill -9 $1
}
alias kill-pid="killpid"
alias kpi="killpid"
alias kpid="killpid"
# Show All Processes Owned By User (usage: mine)
mine() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,bsdtime,command --sort=-%cpu # Note: --sort=-%cpu does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r # Note: bsdtime does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print $1 " | " $2 " | " $3 " | " $4 " | " $5 " | " $6 " | " $7 }'
}
# Show Top 15 CPU Hogs (usage: cpuhogs)
cpuhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
# Show Top 15 Memory Hogs (usage: memhogs)
memhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 3 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
ps-aux-regex() {
  if [ $# -ne 1 ]; then
    echo "Usage: psx <process-name-to-find-using-regex>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | grep -P "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | grep -P "$1"
}
alias psaux="ps-aux-regex"
alias psx="ps-aux-regex"
alias psxre="ps-aux-regex"
alias psxreg="ps-aux-regex"
ps-aux-ignore-case() {
  if [ $# -ne 1 ]; then
    echo "Usage: psxi <process-name-to-find-ignore-case>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | grep -i "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | grep -i "$1"
}
alias psauxi="ps-aux-ignore-case"
alias psauxic="ps-aux-ignore-case"
alias psxi="ps-aux-ignore-case"
alias psxic="ps-aux-ignore-case"
ppkill() {
  if [ $# -ne 1 ]; then
    echo "Usage: ppkill <process-name-to-kill>"
    return 1
  fi
  pkill -9 -f "$1"
}
alias fkill="ppkill"
alias fkill!="ppkill"
alias fq="ppkill"
alias fq!="ppkill"
alias kill!="ppkill"
alias pkill!="ppkill"
alias quit="ppkill"
# Create directory and cd into it (usage: mkcd dirName)
mkcd() {
  if [ $# -ne 1 ]; then
    echo "Usage: mkcd <directory-name-to-create>"
    return 1
  fi
  if [ -d "$1" ]; then
    echo -en "Delete EXISTING folder \033[1;31m$1\033[0m? [y/N]: "
    read -r response
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ ! "$response" =~ ^$ ]]; then
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ -n "$response" ]]; then
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      echo -e "CANCELLED deleting \033[1;33m$1\033[0m (already exists)"
      return 1
    else
      echo -e "\033[1;31mrm -rf $1\033[0m && \033[1;36mmkdir -p $1\033[0m"
      rm -rf "$1"
    fi
  fi
  mkdir -p "$1"
  cd "$1"
  # mkdir -p "$@"
  # cd "$@"
}
# Open Project with IntelliJ (usage: idea .)
idea() {
  open -a "IntelliJ IDEA CE" "$1"
}
# OhMyZSH Override
git_main_branch() {
  echo master
}
# Upgrade Brew Casks
brew-upgrade-casks() {
  brew upgrade --cask $(brew list --cask)
  # brew upgrade --cask $(brew outdated --cask --greedy)
}
# Upgrade zsh plugins
zsh-upgrade-plugins() {
  omz update
  for dir in "$ZSH/custom/plugins"/*; do
    if [ -d "$dir/.git" ]; then
      pluginName=$(basename "$dir")
      echo -e "Updating: \033[1;36m$pluginName\033[0m"
      cd "$dir"
      git pull --rebase --autostash
      # cd - > /dev/null
    else
      echo -e "\033[1;33m$(basename "$dir")\033[0m is NOT a git repository, skipping"
    fi
  done
  cd
}
alias omz-upgrade-plugins="zsh-upgrade-plugins"
alias omz-update="zsh-upgrade-plugins"
alias omz-upgrade="zsh-upgrade-plugins"
alias zsh-update="zsh-upgrade-plugins"
alias zsh-upgrade="zsh-upgrade-plugins"
# Change Java JDK version (usage: jdk 17)
change-jdk() {
  if [ $# -ne 1 ]; then
    echo "Usage: jdk <java-jdk-version-to-use>"
    return 1
  fi
  echo -e "Switching to Java JDK \033[1;32mv$1\033[0m";
  export JAVA_HOME=$(/usr/libexec/java_home -v $1)
  echo "\$JAVA_HOME:" $JAVA_HOME
  echo "\$(java -version):"
  echo "------------------"
  java -version
  echo "------------------"
}
alias jdk="change-jdk"
java_compile_and_run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: jav <source_file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.java' if not present
  if [[ "$srcFile" != *.java ]]; then
    srcFile="${srcFile}.java"
  fi
  local fileName="${srcFile%.*}"
  local outputFile="$fileName.class"
  javac "$srcFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32mjava $fileName\033[0m"
  java "$fileName"
}
alias j--="java_compile_and_run"
alias j++="java_compile_and_run"
alias jav="java_compile_and_run"
alias jc="java_compile_and_run"
alias jcr="java_compile_and_run"
g++_compile_and_run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: gpp <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.cpp' if not present
  if [[ "$srcFile" != *.cpp ]]; then
    srcFile="${srcFile}.cpp"
  fi
  local outputFile="${srcFile%.*}"
  g++-13 "$srcFile" -o "$outputFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32m./$outputFile\033[0m"
  ./"$outputFile"
}
alias c++="g++_compile_and_run"
alias cpp="g++_compile_and_run"
alias g--="g++_compile_and_run"
alias gpp="g++_compile_and_run"
# Delete both local and remote branch (usage: gbdd branchNameToDelete)
gbdd() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdd <branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  local didGitStash=false
  if [ "$currBranch" = "$branchToDelete" ]; then
    echo "Error: You cannot delete the branch you are currently on"
    echo -e "Switching to \033[1;35m$(git_main_branch)\033[0m branch"
    git stash --include-untracked && didGitStash=true
    git checkout $(git_main_branch)
  fi
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in both LOCAL and REMOTE? [yes/N]: "
  # echo -en "Confirm deletion of \033[1;31mlocal/$branchToDelete\033[0m && \033[1;31mremote/$branchToDelete\033[0m? [y/N]: "
  # echo -en "Confirm deletion of \033[1;31mlocal:$branchToDelete\033[0m && \033[1;31mremote:$branchToDelete\033[0m? [y/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY]$ ]] && [[ ! "$response" =~ ^$ ]]; then
  # if [[ ! "$response" =~ ^[yY]$ ]] && [[ -n "$response" ]]; then
  # if [[ ! "$response" =~ ^[yY]$ ]]; then
  # if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  else
    # echo -e "Deleting \033[1;31mlocal/$branchToDelete\033[0m && \033[1;31mremote/$branchToDelete\033[0m"
    # echo -e "Deleting \033[1;31mlocal:$branchToDelete\033[0m && \033[1;31mremote:$branchToDelete\033[0m"
    # echo -e "Deleted branch \033[1;31m$branchToDelete\033[0m"
    echo -e "DELETED branch \033[1;31m$branchToDelete\033[0m in both LOCAL and REMOTE"
    git branch -D "$branchToDelete" # 2>/dev/null
    git push origin --delete "$branchToDelete"
  fi
  if [ "$didGitStash" = true ]; then
    git stash pop
  fi
}
alias gbDd="gbdd"
alias gbDD="gbdd"
# Delete remote branch (usage: gbdr remoteBranchNameToDelete)
gbdr() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdr <remote-branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in REMOTE? [yes/N]: "
  # echo -en "Confirm deletion of \033[1;31mlocal/$branchToDelete\033[0m && \033[1;31mremote/$branchToDelete\033[0m? [y/N]: "
  # echo -en "Confirm deletion of \033[1;31mlocal:$branchToDelete\033[0m && \033[1;31mremote:$branchToDelete\033[0m? [y/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY]$ ]] && [[ ! "$response" =~ ^$ ]]; then
  # if [[ ! "$response" =~ ^[yY]$ ]] && [[ -n "$response" ]]; then
  # if [[ ! "$response" =~ ^[yY]$ ]]; then
  # if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  else
    # echo -e "Deleting \033[1;31mlocal/$branchToDelete\033[0m && \033[1;31mremote/$branchToDelete\033[0m"
    # echo -e "Deleting \033[1;31mlocal:$branchToDelete\033[0m && \033[1;31mremote:$branchToDelete\033[0m"
    # echo -e "Deleted branch \033[1;31m'$branchToDelete'\033[0m in both LOCAL and REMOTE"
    echo -e "Deleted \033[1;31mREMOTE\033[0m branch \033[1;31m$branchToDelete\033[0m"
    # git push origin --delete "$branchToDelete"
    git push origin :"$branchToDelete"
  fi
}
alias gbDr="gbdr"
# gcb newBranch && gco currBranch (used for git worktree workflow) [usage: gcbb newBranch]
gcbb() {
  if [ $# -ne 1 ]; then
    echo "Usage: gcbb <new-branch-name>"
    return 1
  fi
  local newBranch=$1
  if [ "$newBranch" = "$(git_main_branch)" ]; then
    echo -e "ERROR: Cannot create branch \033[1;31m$newBranch\033[0m; it is the default branch"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  if [ "$currBranch" = "$newBranch" ] || git show-ref --verify --quiet refs/heads/"$newBranch"; then
    echo -e "ERROR: Branch \033[1;31m$newBranch\033[0m already exists"
    return 1
  fi
  echo -e "Created branch: \033[1;35m$newBranch\033[0m"
  echo -e "Switched back to branch: \033[1;35m$currBranch\033[0m"
  git checkout -b "$newBranch" && git checkout "$currBranch"
}
alias gcbo="gcbb"
gundo() {
  if [ $# -ne 1 ]; then
    echo "Usage: gundo <number-of-commits-to-rewind>"
    return 1
  fi
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo -e "\033[1;31mERROR: Input must a number > 0\033[0m"
    return 1
  fi
  # totalNumCommits=$(git rev-list --count HEAD)
  # if [ "$1" -gt "$totalNumCommits" ]; then
  #   echo -e "ERROR: Cannot undo \033[1;31m$1\033[0m commits (only \033[1;32m$totalNumCommits\033[0m commits exist)"
  #   return 1
  # fi
  git reset --mixed HEAD~$1
}
# Either a git repository (.git folder) or git worktree repository (.git file && .gitignore file) [usage: is-git-repo; echo $?]
is-git-repo() {
  # V1
  [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } && return 0 || return 1
  # [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) && return 0 || return 1
  # V2
  # [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; }
  # [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ])
  # return $?
}
is-not-git-repo() {
  ! { [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } } && return 0 || return 1
  # ! ( [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) ) && return 0 || return 1
}
safe-git-stash-pop() {
  # if [ $# -ne 1 ] && ! { [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } }; then
  # if [ $# -ne 1 ] && ! ( [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) ); then
  # if [ $# -ne 1 ] && ! is-git-repo; then
  if [ $# -ne 1 ] && ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository, skipping"
    return 1
  fi
  # Try to apply stash without committing it
  local dir=${1:-$(basename $(pwd))}
  if git stash show -p | git apply --check 2>/dev/null; then
    echo -e "\033[1;33mPopping from stash:\033[0m"
    for file in $(git stash show --name-only); do
      # echo -e "\e[1;33m- Modified: $file\e[0m"
      echo -e "\033[1;33m- Modified: $file\033[0m"
    done
    git stash pop > /dev/null 2>&1
  else
    echo -e "\033[1;33mWARNING: Stash conflicts detected in\033[0m \033[1;31m$dir\033[0m (use 'git stash show -p' to see changes && use 'git stash pop' when ready to merge)"
  fi
}
alias can-gstp="safe-git-stash-pop"
update-git-repos() {
  local startDir=$(pwd)
  for dir in */; do
    if [ -d "$dir" ]; then
      # Strip trailing slash
      dir=${dir%/}
      cd "$dir" || continue
      # if [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]); then
      # if [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; }; then
      # if is-git-repo; then
      if [ -d ".git" ]; then
        # echo -e "Updating: \e[1;32m$dir\e[0m"
        echo -e "Updating: \033[1;36m$dir\033[0m"
        if [ -n "$(git status --porcelain)" ]; then
          git stash --include-untracked > /dev/null 2>&1
        fi
        # git fetch --all --prune --tags --force && git pull --rebase --autostash
        # git fetch --all --prune --tags --force > /dev/null 2>&1 && git pull --rebase --autostash > /dev/null 2>&1
        git fetch --all --prune --tags --force > /dev/null 2>&1 && git pull --rebase --autostash
        if [ $(git stash list | wc -l) -gt 0 ]; then
          safe-git-stash-pop "$dir"
        fi
      else
        echo -e "\033[1;33m$dir\033[0m is NOT a git repository, skipping"
      fi
      cd "$startDir"
      echo ""
    fi
  done
}
alias gl-repos="update-git-repos"
git-worktree-add() {
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository, skipping"
    return 1
  fi
  if [ $# -ne 1 ] && [ $# -ne 2 ]; then
    echo "Usage:"
    echo -e "\033[1;32mgwta <target-branch-directory> <target-branch>\033[0m (note: '../' is optional)"
    echo -e "\033[1;32mgwta <target-branch>\033[0m (note: implicitly target-branch-directory = '../\${1//\//-}')"
    return 1
  fi
  if [ $# -eq 1 ]; then
    # local dirname=${1//\//-} # Replace '/' with '-'
    # git worktree add -b "../$dirname" "$1"
    # local dirname="${1#../}"               # First remove '../' prefix if it exists
    # dirname="${dirname#worktree-}"         # Then remove 'worktree-' prefix if it exists
    # dirname="../worktree-${dirname//\//-}" # Replace '/' with '-'
    local dirname="../worktree-${1//\//-}" # Replace '/' with '-'
    echo -e "\033[1;32mCreated\033[0m Git Worktree: \033[1;36m$dirname\033[0m on branch \033[1;35m$1\033[0m"
    git worktree add -b "$dirname" "$1"
  elif [ $# -eq 2 ]; then
    # local dirname="$(echo "$1" | tr -d '/.')" # Remove all occurrences of '/' and '.' from string
    local dirname="${1#../}"               # First remove '../' prefix if it exists
    dirname="${dirname#worktree-}"         # Then remove 'worktree-' prefix if it exists
    dirname="../worktree-${dirname//\//-}" # Replace '/' with '-'
    echo -e "\033[1;32mCreated\033[0m Git Worktree: \033[1;36m$dirname\033[0m on branch \033[1;35m$2\033[0m"
    git worktree add -b "$dirname" "$2"
  fi
}
alias gwta='git-worktree-add'
alias gwtadd='git-worktree-add'
git-worktree-remove() {
  if [ $# -ne 1 ]; then
    echo "Usage: \033[1;32mgwtr <target-branch-directory>\033[0m (note: '../' is optional)"
    return 1
  fi
  # Special case: if $1 is exactly ".", remove the current worktree directory
  if [ "$1" = "." ]; then
    echo -e "\033[1;31mRemoved\033[0m Git Worktree: \033[1;31m$(basename $(pwd))\033[0m"
    git worktree remove .
    return 0
  fi
  # local temp="${1//\//}"         # First remove all '/' characters
  # local dirname="../${temp//./}" # Then remove all '.' characters
  # local dirname="../$(echo "$1" | tr -d '/.')"
  # local dirname="../worktree-$(echo "$1" | tr -d '/.')"
  local dirname="${1#../}"               # First remove '../' prefix if it exists
  dirname="${dirname#worktree-}"         # Then remove 'worktree-' prefix if it exists
  dirname="../worktree-${dirname//\//-}" # Replace '/' with '-'
  if ! [ -d "$dirname" ]; then
    echo -e "ERROR: Git Worktree \033[1;31m$dirname\033[0m does NOT exist"
    return 1
  fi
  echo -e "\033[1;31mRemoved\033[0m Git Worktree: \033[1;31m$dirname\033[0m"
  git worktree remove -f "$dirname"
}
alias gwtr='git-worktree-remove'
alias gwtrm='git-worktree-remove'

