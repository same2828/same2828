# alias memhogs='ps wwaxm -o pid,stat,vsize,rss,time,command | head -10' # Show Top 10 Memory Hogs
# alias c='claude'
alias br='brew'
alias cls='clear'
alias cude='codium'
alias egrep='egrep --color=always -i'
alias finder='explorer.exe'
alias open='explorer.exe'
alias fgrep='fgrep --color=always -i'
alias g++='g++-13'
alias gcc='gcc-13'
alias grep='command grep --color=always -i'
alias grepe='command grep --color=always -iP' # -iE (for FreeBSD/macOS) && -iP (for GNU/Linux) && 'command' to prevent alias expansion for grep alias above
alias grepp='command grep --color=always -iP'
alias grepr='command grep --color=always -iP'
alias grepi='command grep --color=always -i'
alias kc='kilo'
alias ll='command ls -AoF --color=auto'
alias ls='command ls --color=auto'
alias lsd='command ls -Aod --color=auto */'
alias mv='command mv -v'
alias n='npm'
alias n-outdated='npm outdated'
alias n-outdated-g='npm outdated -g'
alias n-update='npm outdated'
alias n-update-g='npm outdated -g'
alias n-upgrade='npm update'
alias n-upgrade-g='npm update -g'
alias p='pnpm'
alias p-outdated='pnpm outdated'
alias p-outdated-g='pnpm outdated -g'
alias p-upgrade='pnpm upgrade'
alias p-upgrade-g='pnpm upgrade -g'
alias port-outdated='sudo port selfupdate && sudo port outdated'
alias port-update='sudo port selfupdate && sudo port outdated'
alias now='date +"%Y-%m-%d %H:%M:%S"'
alias rezsh='source ~/.zshrc'
# alias timeis='date +"%Y-%m-%d@%H:%M:%S"'
alias untar='tar -xvf'
alias zshrc='codium ~/ && codium ~/.zshrc'
