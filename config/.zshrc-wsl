ovies','**/Mp3tag','**/Music','**/node_modules*','**/NVIDIA*','**/opt','**/out','**/output','**/People','**/PerfLogs','**/Personal','**/photo*','**/Photo*','**/pic*','**/Pic*','**/picture*','**/Picture*','**/Postman','**/prebundle','**/private','**/proc','**/Program Files (x86)','**/Program Files','**/ProgramData','**/Public','**/root','**/Root','**/run','**/Saved Games','**/sbin','**/Screenshot*','**/sdist','**/Search*','**/Shared*','**/Sharing*','**/srv','**/Standard Notes*','**/standardnotes*','**/Steam','**/sys','**/System*','**/target.*','**/target*','**/Target*','**/temp*','**/Temp*','**/Thumbs.db','**/tmp*','**/Tmp*','**/Tool*','**/torrent*','**/Torrent*','**/usr','**/Utilities','**/Utility','**/var','**/venv','**/vid*','**/Vid*','**/video*','**/Video*','**/vod*','**/Vod*','**/volumes','**/Volumes','**/vscode*','**/wheels','**/Windows'}"
