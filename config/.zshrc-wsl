# C++
#----
g++-compile-and-run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: g-- <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.cpp' if not present
  if [[ "$srcFile" != *.cpp ]]; then
    srcFile="${srcFile}.cpp"
  fi
  local outputFile="${srcFile%.*}"
  g++-13 "$srcFile" -o "$outputFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32m./$outputFile\033[0m"
  ./"$outputFile"
}
alias c++='g++-compile-and-run'
alias cpp='g++-compile-and-run'
alias g--='g++-compile-and-run'
alias gpp='g++-compile-and-run'

