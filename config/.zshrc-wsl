alias gundo!='git reset --hard ORIG_HEAD' # Undo's the gundo (note: ORIG_HEAD is a reference that points to the previous state of HEAD before disruptive operations like git reset, git rebase, git merge)
alias gwtl='git worktree list' # (cd my-repo || cd target-branch-dir) && gwtl
# alias gwta='git worktree add' # cd my-repo && gwta ../target-branch-dir target-branch
# alias gwtr='git worktree remove' # (cd my-repo && gwtr ../target-branch-dir) || (cd target-branch-dir && gwtr .)

# cd Aliases
#-----------
alias b='cd ..'
alias cdd='cd ~/dev/github'
alias cd1='cd ~/dev/github'
alias cd2='cd ~/dev/github28'

# Aliases
#--------
# alias cpuhogs='ps wwaxr -o pid,stat,%cpu,%mem,time,command | head -10' # Show Top 10 CPU Hogs
