# C++
#----
g++-compile-and-run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: g-- <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.cpp' if not present
  if [[ "$srcFile" != *.cpp ]]; then
    srcFile="${srcFile}.cpp"
  fi
  local outputFile="${srcFile%.*}"
  g++-13 "$srcFile" -o "$outputFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32m./$outputFile\033[0m"
  ./"$outputFile"
}
alias c++="g++-compile-and-run"
alias cpp="g++-compile-and-run"
alias g--="g++-compile-and-run"
alias gpp="g++-compile-and-run"

# Java
#-----
# alias j='f(){ export JAVA_HOME=/usr/libexec/java_home -v $1 }; java -version'
alias j17="export JAVA_HOME=`/usr/libexec/java_home -v 17`; java -version"
alias j21="export JAVA_HOME=$(/usr/libexec/java_home -v 21); java -version"
export JAVA_HOME=$(/usr/libexec/java_home -v 21)
# export JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
alias j="java"
alias jdk-list="/usr/libexec/java_home -V"
# Change Java JDK version (usage: jdk 17)
jdk-change() {
  # if [ $# -ne 1 ]; then
  #   echo "Usage: jdk <java-jdk-version-to-use>"
  #   return 1
  # fi
  echo "------------------------------------------------------------"
  echo "Available Java JDK versions on this system:"
  echo "------------------------------------------------------------"
  /usr/libexec/java_home -V
  echo "------------------------------------------------------------"
  echo -en "Enter Java JDK version to use: "
  read -r response
  echo "------------------------------------------------------------"
  if [[ ! "$response" =~ ^[[:digit:]]{1,2}$ ]]; then
    echo -e "\033[1;31m ERROR: Enter a valid Java JDK version number (e.g., 8, 11, 17, 21)\033[0m"
    return 1
  fi
  echo -e "\033[1;32mSwitched to Java JDK: $response\033[0m";
  export JAVA_HOME=$(/usr/libexec/java_home -v $response)
  java -version
  echo "\$JAVA_HOME:" $JAVA_HOME
}
java-compile() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: j++ <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.java' if not present
  if [[ "$srcFile" != *.java ]]; then
    srcFile="${srcFile}.java"
  fi
  local fileName="${srcFile%.*}"
  local outputFile="$fileName.class"
  javac "$srcFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
}
alias j-compile="java-compile"
java-compile-run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: j++ <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.java' if not present
  if [[ "$srcFile" != *.java ]]; then
    srcFile="${srcFile}.java"
  fi
  local fileName="${srcFile%.*}"
  local outputFile="$fileName.class"
  javac "$srcFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32mjava $fileName\033[0m"
  java "$fileName"
}
alias j-run="java-compile-run"
alias j--="java-compile-run"
alias j++="java-compile-run"
java-info() {
  java -version
  echo "\$JAVA_HOME:" $JAVA_HOME
}
alias which-java="java-info"

# Maven
#------
mvnn() {
  local skip_test_compile=""
  local skip_test_run=""
  local response=""
  local RED='\033[1;31m'
  local GREEN='\033[1;32m'
  local RESET='\033[0m'

  echo -n -e "${RED}Skip Test COMPILATION? [y/N]: ${RESET}"
  read response
  if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    skip_test_compile="-Dmaven.test.skip=true"
  else
    echo -n -e "${RED}Skip Test EXECUTION? [y/N]: ${RESET}"
    read response
    if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
      skip_test_run="-DskipTests"
    fi
  fi

  # Construct and run the command
  # Use array for better argument handling in zsh
  local -a mvn_args
  mvn_args=(clean install -U)
  [[ -n "$skip_test_compile" ]] && mvn_args+=("$skip_test_compile")
  [[ -n "$skip_test_run" ]] && mvn_args+=("$skip_test_run")

  echo -e "${GREEN}Running: mvn ${mvn_args[*]}${RESET}"
  command mvn "${mvn_args[@]}"
}
alias mvn++="mvn clean install -U -DskipTests" # Compiles test classes but skips test execution
alias mvn-compile="mvn clean install -U -DskipTests"
alias mvn-install="mvn clean install -U"
alias mvn-run="mvn spring-boot:run -Dspring-boot.run.arguments=--debug -Dspring-boot.run.profiles=local"
alias mvn-dependency-tree="mvn dependency:tree -Dverbose"
alias mvn-tree="mvn dependency:tree -Dverbose"
mvn-dependency-tree-print-to-file() {
  if [ $# -eq 1 ]; then
    local outputFile="$1"
    mvn dependency:tree -Dverbose -DoutputFile=$outputFile
    return 0
  fi
  mvn dependency:tree -Dverbose -DoutputFile=mvn-dependency-tree.txt
}
alias mvn-tree-cat="mvn-dependency-tree-print-to-file"
mvn-dependency-tree-filter-for-groupId-artifactId() {
  if [ $# -eq 0 ] || [ $# -gt 2 ]; then
    echo "Usage: mvn-tree-filter <groupId> [artifactId] (if artifactId not provided, it will be assumed to be the same as groupId)"
    return 1
  fi
  local groupId="$1"
  local artifactId="$1"
  if [ $# -eq 1 ]; then
    mvn dependency:tree -Dverbose -Dincludes=$groupId:$artifactId
  elif [ $# -eq 2 ]; then
    artifactId="$2"
    mvn dependency:tree -Dverbose -Dincludes=$groupId:$artifactId
  fi
}
alias mvn-tree-filter="mvn-dependency-tree-filter"

# Python
#-------
export PATH="/opt/homebrew/opt/python@3.13/libexec/bin:$PATH"
alias python="python3.13"
alias py="python3.13"

# Custom Functions
# ----------------
# Find process ID of process using given port (usage: find-process-id-on-port 3000)
find-port() {
  if [ $# -ne 1 ]; then
    echo "Usage: fport <port-number-to-search>"
    return 1
  fi
  lsof -i :$1
}
alias fport="find-port"
# Kill process ID of process using given port (usage: kill-process-on-port 3000)
kill-port() {
  if [ $# -ne 1 ]; then
    echo "Usage: kport <port-number-to-free>"
    return 1
  fi
  if [ -z "$(lsof -t -i:$1)" ]; then
    echo -e "NO process is using port: \033[1;32m$1\033[0m"
    return 1
  fi
  kill -9 $(lsof -t -i:$1)
}
# alias kpo="kport" # Note: This CONFLICTS with kpo == k get po
alias kport="kill-port"
alias free-port="kill-port"
# Kill given process id PID (usage: kp 1234)
kill-pid() {
  if [ $# -ne 1 ]; then
    echo "Usage: kpid <pid-to-kill>"
    return 1
  fi
  kill -9 $1
}
alias kpid="kill-pid"
# Show All Processes Owned By User (usage: mine)
mine() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,bsdtime,command --sort=-%cpu # Note: --sort=-%cpu does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r # Note: bsdtime does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print $1 " | " $2 " | " $3 " | " $4 " | " $5 " | " $6 " | " $7 }'
}
# Show Top 15 CPU Hogs (usage: cpuhogs)
cpuhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
# Show Top 15 Memory Hogs (usage: memhogs)
memhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 3 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
ps-aux-regex() {
  if [ $# -ne 1 ]; then
    echo "Usage: psx <process-name-to-find-using-regex>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | grep --color=always -iP "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | grep --color=always -iP "$1"
}
alias psaux="ps-aux-regex"
alias psx="ps-aux-regex"
alias find-pid="ps-aux-regex"
alias fpid="ps-aux-regex"
ps-aux-ignore-case() {
  if [ $# -ne 1 ]; then
    echo "Usage: psxi <process-name-to-find-ignore-case>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | grep --color=always -i "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | grep --color=always -i "$1"
}
alias psauxi="ps-aux-ignore-case"
alias psxi="ps-aux-ignore-case"
ppkill() {
  if [ $# -ne 1 ]; then
    echo "Usage: ppkill <process-name-to-kill>"
    return 1
  fi
  pkill -9 -f "$1"
}
# Create directory and cd into it (usage: mkcd dirName)
mkcd() {
  if [ $# -ne 1 ]; then
    echo "Usage: mkcd <directory-name-to-create>"
    return 1
  fi
  if [ -d "$1" ]; then
    echo -en "Delete EXISTING folder \033[1;31m$1\033[0m? [y/N]: "
    read -r response
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ ! "$response" =~ ^$ ]]; then
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ -n "$response" ]]; then
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      echo -e "CANCELLED deleting \033[1;33m$1\033[0m (already exists)"
      return 1
    else
      echo -e "\033[1;31mrm -rf $1\033[0m && \033[1;36mmkdir -p $1\033[0m"
      rm -rf "$1"
    fi
  fi
  mkdir -p "$1"
  cd "$1"
  # mkdir -p "$@"
  # cd "$@"
}
# Open Project with IntelliJ (usage: idea .)
idea() {
  # open -a "IntelliJ IDEA CE" "$1"
  open -a "IntelliJ IDEA" "$1"
}
# Upgrade Brew Casks
brew-upgrade-casks() {
  brew upgrade --cask $(brew list --cask)
  # brew upgrade --cask $(brew outdated --cask --greedy)
}
# Upgrade zsh plugins
zsh-upgrade-plugins() {
  omz update
  for dir in "$ZSH/custom/plugins"/*; do
    if [ -d "$dir/.git" ]; then
      pluginName=$(basename "$dir")
      echo -e "Updating: \033[1;36m$pluginName\033[0m"
      cd "$dir"
      git pull --rebase --autostash
      # cd - > /dev/null
    else
      echo -e "\033[1;33m$(basename "$dir")\033[0m is NOT a git repository, skipping"
    fi
  done
  cd
}
alias omz-update="zsh-upgrade-plugins"
perl-grep() {
  if [ $# -eq 0 ] || [ $# -gt 2 ]; then
    echo "Usage: pgrep 'regex-pattern' <optional-file-name>"
    return 1
  fi
  local pattern="$1"
  if [ $# -eq 1 ]; then
    # perl -nle "print if /$pattern/gim"
    perl -nle "if (/$pattern/gim) { s/($pattern)/\033[1;31m\$1\033[0m/gim; print }"
  elif [ $# -eq 2 ]; then
    local filename="$2"
    # perl -nle "print if /$pattern/gim" $filename
    perl -nle "if (/$pattern/gim) { s/($pattern)/\033[1;31m\$1\033[0m/gim; print }" $filename
  fi
}
alias prep="perl-grep"
# perl-grep-only-matching() {
#   if [ $# -eq 0 ] || [ $# -gt 2 ]; then
#     echo "Usage: pgrep2 'regex-pattern' <optional-file-name>"
#     return 1
#   fi
#   local pattern="$1"
#   if [ $# -eq 1 ]; then
#     perl -nle "print \"\033[1;31m\$&\033[0m\" while /$pattern/gim"
#   elif [ $# -eq 2 ]; then
#     local filename="$2"
#     perl -nle "print \"\033[1;31m\$&\033[0m\" while /$pattern/gim" $filename
#   fi
# }
# alias prep2="perl-grep-only-matching"
mvv() {
  # Execute mv -v passing all arguments ("$@")
  # Pipe output to sed to perform regex replacement for coloring
  local RED=$'\033[1;31m'
  local GREEN=$'\033[1;32m'
  local RESET=$'\033[0m'
  local MAGENTA=$'\033[1;35m'
  # command mv -v "$@" | sed "s/'\([^']*\)'/'"${MAGENTA}"\1"${RESET}"'/g"
  mv -v "$@" | sed -E "s/'([^']*)'(.*)'([^']*)'/${RED}'\1'${RESET}\2${GREEN}'\3'${RESET}/"
  # mv -v "$@" | perl -pe "s/'([^']*)'(.*)'([^']*)'/${RED}'\1'${RESET}\2${GREEN}'\3'${RESET}/"
}
wipe() {
  if [ $# -ne 1 ]; then
    echo "Usage: wipe <file-to-wipe>"
    return 1
  fi
  local fileToWipe=$1
  if [ ! -f "$fileToWipe" ]; then
    echo -e "ERROR: File \033[1;31m$fileToWipe\033[0m does not exist"
    return 1
  fi
  echo -en "Confirm WIPING of file \033[1;31m$fileToWipe\033[0m? [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
    echo -e "Wipe CANCELLED"
    return 1
  fi
  # cat /dev/null > "$fileToWipe"
  # : >| "$fileToWipe"
  truncate -s 0 "$fileToWipe"
  echo -e "Wiped file \033[1;31m$fileToWipe\033[0m"
}
jq-sort() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jq-sort <json-file-to-sort-alphabetically>"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).json"
  jq -S '.' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
}
jq-convert-stringifiedJson-to-json() {
  local tempFile="tmp-$(date +%s).json"
  if [ $# -eq 1 ]; then
    # jq --arg key "$1" '.[$key] | fromjson' > "$tempFile"
    jq ".$1 | fromjson" > "$tempFile"
  else
    jq '. | fromjson' > "$tempFile"
  fi
  echo "Saved to: $tempFile"
}
yq-sort() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jq-sort <yaml-file-to-sort-alphabetically>"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).yaml"
  yq 'sort_keys(..)' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
}
timeis() {
  date +"%Y-%m-%d@%H:%M:%S"
  date +"%Y-%m-%d-%H:%M:%S"
  date +"%Y-%m-%d-%H-%M-%S"
  date +"%d-%m-%Y@%H:%M:%S"
  date +"%d-%m-%Y-%H:%M:%S"
  date +"%d-%m-%Y-%H-%M-%S"
  date +%s
}
timeis2() {
  date +"%Y-%m-%d@%I:%M:%S%p"
  date +"%Y-%m-%d-%I:%M:%S%p"
  date +"%Y-%m-%d-%I-%M-%S%p"
  date +"%d-%m-%Y@%I:%M:%S%p"
  date +"%d-%m-%Y-%I:%M:%S%p"
  date +"%d-%m-%Y-%I-%M-%S%p"
  date +%s
}

# Git Functions
#--------------
# Delete both local and remote branch (usage: gbdd branchNameToDeleteInLocalAndRemote)
delete-local-and-remote-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdd <branch-name-to-delete-in-local-and-remote>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  local didGitStash=false
  if [ "$currBranch" = "$branchToDelete" ]; then
    echo -e "\033[1;31mError: You cannot delete the branch you are currently on\033[0m"
    echo -e "Switching to \033[1;35m$(git_main_branch)\033[0m branch"
    git stash --include-untracked && didGitStash=true
    git checkout $(git_main_branch)
  fi
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in both \033[1;35mLOCAL\033[0m and \033[1;35mREMOTE\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]] && [[ ! "$response" =~ ^[yY]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  # if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  echo -e "DELETED branch \033[1;31m$branchToDelete\033[0m in both \033[1;35mLOCAL\033[0m and \033[1;35mREMOTE\033[0m"
  git branch -D "$branchToDelete" # 2>/dev/null
  git push origin --delete "$branchToDelete"
  if [ "$didGitStash" = true ]; then
    git stash pop
  fi
}
alias gbdd="delete-local-and-remote-branch"
# Delete local branch only (usage: gbd localBranchNameToDelete)
delete-local-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbd <local-branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  local didGitStash=false
  if [ "$currBranch" = "$branchToDelete" ]; then
    echo -e "\033[1;31mError: You cannot delete the branch you are currently on\033[0m"
    echo -e "Switching to \033[1;35m$(git_main_branch)\033[0m branch"
    git stash --include-untracked && didGitStash=true
    git checkout $(git_main_branch)
  fi
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in \033[1;35mLOCAL\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  # if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  # echo -e "Deleted \033[1;31mLOCAL\033[0m branch \033[1;31m$branchToDelete\033[0m"
  echo -e "Deleted branch \033[1;31m$branchToDelete\033[0m in \033[1;35mLOCAL\033[0m"
  git branch --delete --force "$branchToDelete"
  if [ "$didGitStash" = true ]; then
    git stash pop
  fi
}
alias gbd="delete-local-branch"
alias gbdl="delete-local-branch"
# Delete remote branch only (usage: gbdr remoteBranchNameToDelete)
delete-remote-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdr <remote-branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in \033[1;35mREMOTE\033[0m? [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  # echo -e "Deleted \033[1;35mREMOTE\033[0m branch \033[1;31m$branchToDelete\033[0m"
  echo -e "Deleted branch \033[1;31m$branchToDelete\033[0m in \033[1;35mREMOTE\033[0m"
  # git push origin --delete "$branchToDelete"
  git push origin :"$branchToDelete"
}
alias gbdr="delete-remote-branch"
# gcb newBranch && gco currBranch (used for git worktree workflow) [usage: gcbb newBranch]
gcbb() {
  if [ $# -ne 1 ]; then
    echo "Usage: gcbb <new-branch-name>"
    return 1
  fi
  local newBranch=$1
  if [ "$newBranch" = "$(git_main_branch)" ]; then
    echo -e "ERROR: Cannot create branch \033[1;31m$newBranch\033[0m; it is the default branch"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  if [ "$currBranch" = "$newBranch" ] || git show-ref --verify --quiet refs/heads/"$newBranch"; then
    echo -e "ERROR: Branch \033[1;31m$newBranch\033[0m already exists"
    return 1
  fi
  echo -e "Created branch: \033[1;35m$newBranch\033[0m"
  echo -e "Switched back to branch: \033[1;35m$currBranch\033[0m"
  git checkout -b "$newBranch" && git checkout "$currBranch"
}
alias gcbo="gcbb"
gundo() {
  if [ $# -ne 1 ]; then
    echo "Usage: gundo <number-of-commits-to-rewind>"
    return 1
  fi
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo -e "\033[1;31mERROR: Input must a number > 0\033[0m"
    return 1
  fi
  # totalNumCommits=$(git rev-list --count HEAD)
  # if [ "$1" -gt "$totalNumCommits" ]; then
  #   echo -e "ERROR: Cannot undo \033[1;31m$1\033[0m commits (only \033[1;32m$totalNumCommits\033[0m commits exist)"
  #   return 1
  # fi
  echo -e "Running: \033[1;35mgit reset --mixed HEAD~$1$\033[0m"
  git reset --mixed HEAD~$1
}
git-reset-hard() {
  # if [ $# -gt 0 ]; then
  #   echo -en "Confirm \033[1;31mgit reset --hard $@\033[0m? [yes/N]: "
  # else
  #   echo -en "Confirm \033[1;31mgit reset --hard\033[0m? [yes/N]: "
  # fi
  echo -en "Confirm \033[1;31mgit reset --hard${@:+ $@}\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard CANCELLED"
    return 1
  fi
  if [ $# -eq 0 ]; then
    git reset --hard && git clean -fd
    return
  fi
  git reset --hard "$@"
}
alias grh="git-reset-hard"
alias greset="git-reset-hard"
alias greseth="git-reset-hard"
git-reset-hard-and-git-clean() {
  # if [ $# -gt 0 ]; then
  #   echo -en "Confirm \033[1;31mgit reset --hard $@ && git clean -fd\033[0m? [yes/N]: "
  # else
  #   echo -en "Confirm \033[1;31mgit reset --hard && git clean -fd\033[0m? [yes/N]: "
  # fi
  echo -en "Confirm \033[1;31mgit reset --hard${@:+ $@} && git clean -fd\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard && git clean -fd CANCELLED"
    return 1
  fi
  if [ $# -eq 0 ]; then
    git reset --hard && git clean -fd
    return
  fi
  git reset --hard "$@" && git clean -fd
}
alias grh!="git-reset-hard-and-git-clean"
alias greset!="git-reset-hard-and-git-clean"
alias greseth!="git-reset-hard-and-git-clean"
git-reset-hard-origin() {
  local currBranch=$(git_current_branch)
  echo -en "Confirm \033[1;31mgit reset --hard origin/$currBranch\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard origin/$currBranch CANCELLED"
    return 1
  fi
  git fetch --all --prune --tags --force && git reset --hard origin/$(git_current_branch)
}
alias grho="git-reset-hard-origin"
alias greseto="git-reset-hard-origin"
alias gresetho="git-reset-hard-origin"
git-reset-hard-origin-and-git-clean() {
  local currBranch=$(git_current_branch)
  echo -en "Confirm \033[1;31mgit reset --hard origin/$currBranch && git clean -fd\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard origin/$currBranch && git clean -fd CANCELLED"
    return 1
  fi
  git fetch --all --prune --tags --force && git reset --hard origin/$(git_current_branch) && git clean -fd
}
alias grho!="git-reset-hard-origin-and-git-clean"
alias greseto!="git-reset-hard-origin-and-git-clean"
alias gresetho!="git-reset-hard-origin-and-git-clean"
# Either a git repository (.git folder) or git worktree repository (.git file && .gitignore file) [usage: is-git-repo; echo $?]
is-git-repo() {
  # V1
  [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } && return 0 || return 1
  # [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) && return 0 || return 1
  # V2
  # [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; }
  # [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ])
  # return $?
}
is-not-git-repo() {
  ! { [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } } && return 0 || return 1 # The curly braces {} group commands together but execute them in the current shell context (more efficient) (requires spaces around braces and semicolon before closing brace)
  # ! ( [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) ) && return 0 || return 1 # The parentheses () create a subshell to execute the commands (less efficient) (does not require special spacing or semicolons)
}
safe-git-stash-pop() {
  # if [ $# -ne 1 ] && ! { [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; } }; then
  # if [ $# -ne 1 ] && ! ( [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]) ); then
  # if [ $# -ne 1 ] && ! is-git-repo; then
  if [ $# -ne 1 ] && ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository, skipping"
    return 1
  fi
  # Try to apply stash without committing it
  local dir=${1:-$(basename $(pwd))}
  if git stash show -p | git apply --check 2>/dev/null; then
    echo -e "\033[1;33mPopping from stash:\033[0m"
    for file in $(git stash show --name-only); do
      # echo -e "\e[1;33m- Modified: $file\e[0m"
      echo -e "\033[1;33m- Modified: $file\033[0m"
    done
    git stash pop > /dev/null 2>&1
  else
    echo -e "\033[1;33mWARNING: Stash conflicts detected in\033[0m \033[1;31m$dir\033[0m (use 'git stash show -p' to see changes && use 'git stash pop' when ready to merge)"
  fi
}
alias can-gstp="safe-git-stash-pop"
update-git-repos() {
  local startDir=$(pwd)
  for dir in */; do
    if [ -d "$dir" ]; then
      # Strip trailing slash
      dir=${dir%/}
      cd "$dir" || continue
      # if [ -d ".git" ] || ([ -f ".git" ] && [ -f ".gitignore" ]); then
      # if [ -d ".git" ] || { [ -f ".git" ] && [ -f ".gitignore" ]; }; then
      # if is-git-repo; then
      if [ -d ".git" ]; then
        # echo -e "Updating: \e[1;32m$dir\e[0m"
        echo -e "Updating: \033[1;36m$dir\033[0m"
        if [ -n "$(git status --porcelain)" ]; then
          git stash --include-untracked > /dev/null 2>&1
        fi
        # git fetch --all --prune --tags --force && git pull --rebase --autostash
        # git fetch --all --prune --tags --force > /dev/null 2>&1 && git pull --rebase --autostash > /dev/null 2>&1
        git fetch --all --prune --tags --force > /dev/null 2>&1 && git pull --rebase --autostash
        if [ $(git stash list | wc -l) -gt 0 ]; then
          safe-git-stash-pop "$dir"
        fi
      else
        echo -e "\033[1;33m$dir\033[0m is NOT a git repository, skipping"
      fi
      cd "$startDir"
      echo ""
    fi
  done
}
alias gl-repos="update-git-repos"
git-local-only-branches() {
  # Ensure we are in a git repository
  # if ! git rev-parse --git-dir >/dev/null 2>&1; then
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi
  if ! git fetch --all --prune --tags --force &>/dev/null; then
    echo -e "ERROR: Failed to fetch updates from remote"
    return 1
  fi
  echo "LOCAL branches with NO remote/upstream counterpart:"
  local branch
  # Iterate through all local branches
  # V1:
  # for branch in $(git branch --format='%(refname:short)'); do
  #   # Check if the branch has an upstream configured AND if that upstream ref still exists
  #   # The @{u} shorthand resolves to the upstream branch ref.
  #   # If it fails (exit code != 0), the upstream is missing or was pruned.
  #   if ! git rev-parse --abbrev-ref --symbolic-full-name "${branch}@{u}" >/dev/null 2>&1; then
  #     echo "  \033[1;35m$branch\033[0m"
  #   fi
  # done
  # V2:
  # git for-each-ref --format='%(refname:short)' refs/heads/ | while read -r branch; do
  #   if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then
  #     echo "  \033[1;35m$branch\033[0m"
  #   fi
  # done
  git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
    if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then # >/dev/null 2>&1 == &>/dev/null (but the later is Bash-specific)
      echo "  \033[1;35m$branch\033[0m"
    fi
  done
}
alias gbl="git-local-only-branches"
alias gb-local="git-local-only-branches"
alias gb-norem="git-local-only-branches"
alias gb-noremote="git-local-only-branches"
alias gb-no-remote="git-local-only-branches"
git-delete-branches-with-no-upstream() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi

  if ! git fetch --all --prune --tags --force &>/dev/null; then
    echo -e "ERROR: Failed to fetch updates from remote"
    return 1
  fi

  git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
    # Check if branch has no upstream
    if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then
      echo -n "Delete branch '\033[1;35m$branch\033[0m'? [y/N]: "
      read -r response
      if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
        echo -e "\033[1;31mDeleted: $branch\033[0m"
        git branch -D "$branch"
      else
        echo -e "\033[1;32mKept: $branch\033[0m"
      fi
    fi
  done
}
alias gbd-norem="git-delete-branches-with-no-upstream"
alias gbd-noremote="git-delete-branches-with-no-upstream"
alias gbd-no-remote="git-delete-branches-with-no-upstream"
git-delete-branches--with-no-upstream-auto() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi

  if ! git fetch --all --prune --tags --force &>/dev/null; then
    echo -e "ERROR: Failed to fetch updates from remote"
    return 1
  fi

  git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
    # Check if branch has no upstream
    if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then
      echo -e "\033[1;31mDeleted: $branch\033[0m"
      git branch -D "$branch"
    fi
  done
}
git-worktree-add() {
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi
  if [ $# -ne 1 ] && [ $# -ne 2 ]; then
    echo "Usage:"
    echo -e "\033[1;32mgwta <target-branch-directory> <target-branch>\033[0m (note: '../' is optional)"
    echo -e "\033[1;32mgwta <target-branch>\033[0m (note: implicitly target-branch-directory = '../\${1//\//-}')"
    return 1
  fi
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT the ROOT git repository"
    return 1
  fi
  local repoName=$(basename $(pwd))
  if [ $# -eq 1 ]; then
    # Check if the given branch $1 exists
    if ! git rev-parse --verify "$1" >/dev/null 2>&1; then
      echo -e "ERROR: Branch \033[1;31m$1\033[0m does NOT exist"
      return 1
    fi
    local dirname="${1#../}"                # First remove '../' prefix if it exists
    dirname="${dirname#worktree-}"          # Then remove 'worktree-' prefix if it exists
    dirname="${dirname#$repoName-}"         # Then remove '$repoName-' prefix if it exists
    dirname="../$repoName-${dirname//\//-}" # Replace '/' with '-'local dirname="../${1//\//-}" # Replace '/' with '-'
    if [ -d "$1" ]; then
      echo -e "ERROR: Directory \033[1;31m$1\033[0m ALREADY exists"
      return 1
    fi
    echo -e "\033[1;32mCreated\033[0m Git Worktree: \033[1;36m$dirname\033[0m on branch \033[1;35m$1\033[0m"
    git worktree add "$dirname" "$1"
  elif [ $# -eq 2 ]; then
    # Check if the given branch $2 exists
    if ! git rev-parse --verify "$2" >/dev/null 2>&1; then
      echo -e "ERROR: Branch \033[1;31m$2\033[0m does NOT exist"
      return 1
    fi
    # local dirname="$(echo "$1" | tr -d '/.')" # Remove all occurrences of '/' and '.' from string
    local dirname="${1#../}"                # First remove '../' prefix if it exists
    dirname="${dirname#worktree-}"          # Then remove 'worktree-' prefix if it exists
    dirname="${dirname#$repoName-}"         # Then remove '$repoName-' prefix if it exists
    dirname="../$repoName-${dirname//\//-}" # Replace '/' with '-'
    if [ -d "$1" ]; then
      echo -e "ERROR: Directory \033[1;31m$1\033[0m ALREADY exists"
      return 1
    fi
    echo -e "Created Git Worktree: \033[1;36m$dirname\033[0m on branch \033[1;35m$2\033[0m"
    git worktree add "$dirname" "$2"
  fi
}
alias gwta='git-worktree-add'
alias gwtadd='git-worktree-add'
git-worktree-remove() {
  if [ $# -ne 1 ]; then
    echo "Usage: \033[1;32mgwtr <target-branch-directory>\033[0m (note: '../' is optional)"
    return 1
  fi
  # Special case: if $1 is exactly ".", remove the current worktree directory
  if [ "$1" = "." ]; then
    echo -e "\033[1;31mRemoved\033[0m Git Worktree: \033[1;31m$(basename $(pwd))\033[0m"
    git worktree remove -f .
    return 0
  fi
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT the ROOT git repository"
    return 1
  fi
  local repoName=$(basename $(pwd))
  # local temp="${1//\//}"         # First remove all '/' characters
  # local dirname="../${temp//./}" # Then remove all '.' characters
  # local dirname="../$(echo "$1" | tr -d '/.')"
  # local dirname="../worktree-$(echo "$1" | tr -d '/.')"
  local dirname="${1#../}"                # First remove '../' prefix if it exists
  dirname="${dirname#worktree-}"          # Then remove 'worktree-' prefix if it exists
  dirname="${dirname#$repoName-}"         # Then remove '$repoName-' prefix if it exists
  dirname="../$repoName-${dirname//\//-}" # Replace '/' with '-'
  if ! [ -d "$dirname" ]; then
    echo -e "ERROR: Git Worktree Directory \033[1;31m$dirname\033[0m does NOT exist"
    return 1
  fi
  echo -e "Removed Git Worktree: \033[1;31m$dirname\033[0m"
  git worktree remove -f "$dirname"
}
alias gwtr='git-worktree-remove'
alias gwtrm='git-worktree-remove'

