# Python
#-------
export PATH="/opt/homebrew/opt/python@3.13/libexec/bin:$PATH"
alias python='python3.13'
alias py='python3.13'

# Custom Functions
# ----------------
# Find process ID of process using given port (usage: find-process-id-on-port 3000)
find-port() {
  if [ $# -ne 1 ]; then
    echo "Usage: fport <port-number-to-search>"
    return 1
  fi
  lsof -i :$1
}
alias fport='find-port'
# Kill process ID of process using given port (usage: kill-process-on-port 3000)
kill-port() {
  if [ $# -ne 1 ]; then
    echo "Usage: kport <port-number-to-free>"
    return 1
  fi
  if [ -z "$(lsof -t -i:$1)" ]; then
    echo -e "NO process is using port: \033[1;32m$1\033[0m"
    return 1
  fi
  kill -9 $(lsof -t -i:$1)
}
# alias kpo='kport' # Note: This CONFLICTS with kpo == k get po
alias kport='kill-port'
alias free-port='kill-port'
# Kill given process id PID (usage: kp 1234)
kill-pid() {
  if [ $# -ne 1 ]; then
    echo "Usage: kpid <pid-to-kill>"
    return 1
  fi
  kill -9 $1
}
alias kpid='kill-pid'
# Show All Processes Owned By User (usage: mine)
mine() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,bsdtime,command --sort=-%cpu # Note: --sort=-%cpu does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r # Note: bsdtime does NOT work on macOS
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print }'
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,etime,command | sort -k 2 -r | awk '{ $7=substr($7,1,70); for(i=8;i<=NF;i++) $7=$7" "$i; $7=substr($7,1,70); NF=7; print $1 " | " $2 " | " $3 " | " $4 " | " $5 " | " $6 " | " $7 }'
}
# Show Top 15 CPU Hogs (usage: cpuhogs)
cpuhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 2 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
# Show Top 15 Memory Hogs (usage: memhogs)
memhogs() {
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,command | sort -k 3 -r | head -15 | awk '{ $5=substr($5,1,70); for(i=6;i<=NF;i++) $5=$5" "$i; $5=substr($5,1,70); NF=5; printf "%5s %4s %4s %7s %-70s\n", $1, $2, $3, $4, $5 }'
}
ps-aux-regex() {
  if [ $# -ne 1 ]; then
    echo "Usage: psx <process-name-to-find-using-regex>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | perl-grep "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | perl-grep "$1"
}
alias psaux='ps-aux-regex'
alias psx='ps-aux-regex'
alias find-pid='ps-aux-regex'
alias fpid='ps-aux-regex'
ps-aux-ignore-case() {
  if [ $# -ne 1 ]; then
    echo "Usage: psxi <process-name-to-find-ignore-case>"
    return 1
  fi
  # ps ax -o user,pid,%cpu,%mem,start,command | perl-grep "$1"
  ps ax -o user,pid,%cpu,%mem,start,command | sort -k 3 -r | perl-grep "$1"
}
alias psauxi='ps-aux-ignore-case'
alias psxi='ps-aux-ignore-case'
ppkill() {
  if [ $# -ne 1 ]; then
    echo "Usage: ppkill <process-name-to-kill>"
    return 1
  fi
  pkill -9 -f "$1"
}
# Create directory and cd into it (usage: mkcd dirName)
mkcd() {
  if [ $# -ne 1 ]; then
    echo "Usage: mkcd <directory-name-to-create>"
    return 1
  fi
  if [ -d "$1" ]; then
    echo -en "Delete EXISTING folder \033[1;31m$1\033[0m? [y/N]: "
    read -r response
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ ! "$response" =~ ^$ ]]; then
    # if [[ ! "$response" =~ ^[yY]$ ]] && [[ -n "$response" ]]; then
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      echo -e "CANCELLED deleting \033[1;33m$1\033[0m (already exists)"
      return 1
    else
      echo -e "\033[1;31mrm -rf $1\033[0m && \033[1;36mmkdir -p $1\033[0m"
      rm -rf "$1"
    fi
  fi
  mkdir -p "$1"
  cd "$1"
  # mkdir -p "$@"
  # cd "$@"
}
# Open Project with IntelliJ (usage: idea .)
idea() {
  # open -a "IntelliJ IDEA CE" "$1"
  open -a "IntelliJ IDEA" "$1"
}
# Upgrade zsh plugins
zsh-upgrade-plugins() {
  omz update
  for dir in "$ZSH/custom/plugins"/*; do
    if [ -d "$dir/.git" ]; then
      pluginName=$(basename "$dir")
      echo -e "Updating: \033[1;36m$pluginName\033[0m"
      cd "$dir"
      git pull --rebase --autostash
      # cd - > /dev/null
    else
      echo -e "\033[1;33m$(basename "$dir")\033[0m is NOT a git repository, skipping"
    fi
  done
  cd
}
alias omz-update='zsh-upgrade-plugins'
mvv() {
  # Execute mv -v passing all arguments ("$@")
  # Pipe output to sed to perform regex replacement for coloring
  local RED=$'\033[1;31m'
  local GREEN=$'\033[1;32m'
  local RESET=$'\033[0m'
  local MAGENTA=$'\033[1;35m'
  # command mv -v "$@" | sed "s/'\([^']*\)'/'"${MAGENTA}"\1"${RESET}"'/g"
  mv -v "$@" | sed -E "s/'([^']*)'(.*)'([^']*)'/${RED}'\1'${RESET}\2${GREEN}'\3'${RESET}/"
  # mv -v "$@" | perl -pe "s/'([^']*)'(.*)'([^']*)'/${RED}'\1'${RESET}\2${GREEN}'\3'${RESET}/"
}
wipe() {
  if [ $# -ne 1 ]; then
    echo "Usage: wipe <file-to-wipe>"
    return 1
  fi
  local fileToWipe=$1
  if [ ! -f "$fileToWipe" ]; then
    echo -e "ERROR: File \033[1;31m$fileToWipe\033[0m does not exist"
    return 1
  fi
  echo -en "Confirm WIPING of file \033[1;31m$fileToWipe\033[0m? [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
    echo -e "Wipe CANCELLED"
    return 1
  fi
  # cat /dev/null > "$fileToWipe"
  # : >| "$fileToWipe"
  truncate -s 0 "$fileToWipe"
  echo -e "Wiped file \033[1;31m$fileToWipe\033[0m"
}
jq-sort() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jq-sort <json-file-to-sort-alphabetically>"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).json"
  jq -S '.' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
}
jq-array-sort() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: jq-array-sort [fields to 'sort_by' such as .foo or '.foo, .bar'] <json-array-file>"
    return 1
  fi
  # Grab the last argument as the file
  local file="${2:-$1}"
  if [[ ! -f "$file" ]]; then
    echo -e "ERROR: \033[1;31m$file\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).json"
  if [[ $# -eq 1 ]]; then
    jq 'sort' "$file" > "$tempFile" && command mv -v "$tempFile" "$file" || rm -f "$tempFile"
  else
    jq 'sort_by('"$1"')' "$file" > "$tempFile" && command mv -v "$tempFile" "$file" || rm -f "$tempFile"
  fi
}
jq-array-dedup() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: jq-array-dedup [field to 'unique_by' such as '.id' or 'length'] <json-array-file>"
    return 1
  fi

  local file="${2:-$1}"
  if [[ ! -f "$file" ]]; then
    echo -e "ERROR: \033[1;31m$file\033[0m file not found"
    return 1
  fi

  local tempFile="tmp-$(date +%s).json"
  if [[ $# -eq 1 ]]; then
    jq 'unique' "$file" > "$tempFile" && command mv -v "$tempFile" "$file" || rm -f "$tempFile"
  else
    jq 'unique_by('"$1"')' "$file" > "$tempFile" && command mv -v "$tempFile" "$file" || rm -f "$tempFile"
  fi
}
jq-convert-stringified-to-json() {
  if [ $# -lt 1 ]; then
    echo -e "Usage: \033[1;32mjq-convert-stringified-to-json <file> [key]\033[0m"
    echo -e "Omit \033[1;31m[key]\033[0m if \033[1;34m<file>\033[0m contains ONLY stringified JSON in quotes: \033[1;31m\"{\\\"key\\\": \\\"value\\\"}\"\033[0m"
    echo -e "Otherwise: \033[1;32mcat <file>\033[0m = \033[1;31m{ \"key-provided-as-\$1\": \"insert-stringified-json-here\" }\033[0m"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).json"
  if [ $# -eq 1 ]; then
    # cat "$1" | jq '. | fromjson' >"$tempFile"
    jq '. | fromjson' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
  else
    # cat "$1" | jq ".$2 | fromjson" >"$tempFile"
    jq --arg key "$2" '.[$key] | fromjson' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
  fi
}
yq-convert-json-to-yaml() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: yq-convert-json-to-yaml <json-file-to-convert-to-yaml>"
    return 1
  fi
  if [[ "$1" != *.json ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m is not a .json file"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local yamlFile="${1%.*}.yaml"
  yq -p json -Poy "$1" > "$yamlFile"
  echo -e "Converted $1 to \033[1;35m$yamlFile\033[0m"
}
yq-convert-xml-to-json() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jq-sort <json-file-to-sort-alphabetically>"
    return 1
  fi
  if [[ "$1" != *.xml ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m is not an .xml file"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempYamlFile="tmp-$(date +%s).yaml"
  local jsonFile="${1%.*}.json"
  yq -Poy "$1" > "$tempYamlFile" && yq -oj -I2 "$tempYamlFile" > $jsonFile || { rm -f "$tempYamlFile"; return 1; }
  echo -e "Converted $1 to \033[1;35m$jsonFile\033[0m"
}
yq-convert-xml-to-yaml() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: yq-convert-xml-to-yaml <xml-file-to-convert-to-yaml>"
    return 1
  fi
  if [[ "$1" != *.xml ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m is not an .xml file"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local yamlFile="${1%.*}.yaml"
  yq -Poy "$1" > "$yamlFile"
  echo -e "Converted $1 to \033[1;35m$yamlFile\033[0m"
}
yq-convert-yaml-to-json() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: yq-convert-yaml-to-json <yaml-file-to-convert-to-json>"
    return 1
  fi
  if [[ "$1" != *.yaml && "$1" != *.yml ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m is not a .yaml or .yml file"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempYamlFile="tmp-$(date +%s).yaml"
  local jsonFile="${1%.*}.json"
  yq -p yaml -Poy "$1" > "$tempYamlFile" && yq -oj -I2 "$tempYamlFile" > "$jsonFile" || { rm -f "$tempYamlFile"; return 1; }
  rm -f "$tempYamlFile"
  echo -e "Converted $1 to \033[1;35m$jsonFile\033[0m"
}
yq-sort() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jq-sort <yaml-file-to-sort-alphabetically>"
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo -e "ERROR: \033[1;31m$1\033[0m file not found"
    return 1
  fi
  local tempFile="tmp-$(date +%s).yaml"
  yq 'sort_keys(..)' "$1" > "$tempFile" && command mv -v "$tempFile" "$1" || rm -f "$tempFile"
}
timeis() {
  echo -e "----------"
  echo -e "YYYY-MM-DD"
  echo -e "----------"
  date +"%Y-%m-%d@%H:%M:%S"
  date +"%Y-%m-%d-%H:%M:%S"
  date +"%Y-%m-%d-%H-%M-%S"
  echo -e "----------"
  echo -e "DD-MM-YYYY"
  echo -e "----------"
  date +"%d-%m-%Y@%H:%M:%S"
  date +"%d-%m-%Y-%H:%M:%S"
  date +"%d-%m-%Y-%H-%M-%S"
  echo -e "--------------"
  echo -e "Unix Timestamp"
  echo -e "--------------"
  date +%s
}
timeis2() {
  echo -e "----------"
  echo -e "YYYY-MM-DD"
  echo -e "----------"
  date +"%Y-%m-%d@%I:%M:%S%p"
  date +"%Y-%m-%d-%I:%M:%S%p"
  date +"%Y-%m-%d-%I-%M-%S%p"
  echo -e "----------"
  echo -e "DD-MM-YYYY"
  echo -e "----------"
  date +"%d-%m-%Y@%I:%M:%S%p"
  date +"%d-%m-%Y-%I:%M:%S%p"
  date +"%d-%m-%Y-%I-%M-%S%p"
  echo -e "--------------"
  echo -e "Unix Timestamp"
  echo -e "--------------"
  date +%s
}
brew-outdated() {
  command brew update-reset > /dev/null 2>&1
  command brew update > /dev/null 2>&1
  command brew cleanup > /dev/null 2>&1
  echo "--------------------------------------------------"
  echo "Formulae"
  echo "--------------------------------------------------"
  command brew outdated --formula
  echo "--------------------------------------------------"
  echo "Casks"
  echo "--------------------------------------------------"
  # brew outdated --cask --greedy
  brew outdated --cask --greedy-auto-updates
}
alias brew-update='brew-outdated'
brew-reset() {
  command brew update-reset
}

# Git Functions
#--------------
# Identify if current directory is a git repository by checking for .git folder or file (to handle both normal and submodule repositories)
in-git-repo() {
  # The function implicitly returns the exit status of the git command (0 for success/true, non-zero for failure/false)
  command git rev-parse --is-inside-work-tree >/dev/null 2>&1
}
not-in-git-repo() {
  ! command git rev-parse --is-inside-work-tree >/dev/null 2>&1
}
git-push-force-with-lease-with-confirmation() {
  if ! in-git-repo; then
    # echo "ERROR: ${PWD##*/} is NOT a git repository"
    echo "ERROR: $(basename "$PWD") is NOT a git repository"
    return 1
  fi
  local currBranch=$(git_current_branch)
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm \033[1;31mgit push --force-with-lease\033[0m on branch \033[1;35m$currBranch\033[0m [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "CANCELLED git push --force-with-lease --force-if-includes"
    return 1
  fi
  git push --force-with-lease --force-if-includes
}
alias gpf='git-push-force-with-lease-with-confirmation'
alias gpf!='git-push-force-with-lease-with-confirmation'
git-push-force-with-confirmation() {
  if ! in-git-repo; then
    # echo "ERROR: ${PWD##*/} is NOT a git repository"
    echo "ERROR: $(basename "$PWD") is NOT a git repository"
    return 1
  fi
  local currBranch=$(git_current_branch)
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm \033[1;31mgit push --force-with-lease\033[0m on branch \033[1;35m$currBranch\033[0m [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "CANCELLED git push --force"
    return 1
  fi
  git push --force
}
alias gpF!='git-push-force-with-confirmation'
# Delete local branch only (usage: gbd localBranchNameToDelete)
git-delete-local-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbd <local-branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  local didGitStash=false
  if [ "$currBranch" = "$branchToDelete" ]; then
    echo -e "\033[1;31mError: You cannot delete the branch you are currently on\033[0m"
    echo -e "Switching to \033[1;35m$(git_main_branch)\033[0m branch"
    git stash --include-untracked && didGitStash=true
    git checkout $(git_main_branch)
  fi
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in \033[1;35mLOCAL\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  # if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  # echo -e "Deleted \033[1;31mLOCAL\033[0m branch \033[1;31m$branchToDelete\033[0m"
  echo -e "Deleted branch \033[1;31m$branchToDelete\033[0m in \033[1;35mLOCAL\033[0m"
  git branch --delete --force "$branchToDelete"
  if [ "$didGitStash" = true ]; then
    git stash pop
  fi
}
alias gbd='git-delete-local-branch'
alias gbD='git-delete-local-branch'
# Delete remote branch only (usage: gbdr remoteBranchNameToDelete)
git-delete-remote-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdr <remote-branch-name-to-delete>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in \033[1;35mREMOTE\033[0m? [yes/N]: "
  read -r response
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  # echo -e "Deleted \033[1;35mREMOTE\033[0m branch \033[1;31m$branchToDelete\033[0m"
  echo -e "Deleted branch \033[1;31m$branchToDelete\033[0m in \033[1;35mREMOTE\033[0m"
  # git push origin --delete "$branchToDelete"
  git push origin :"$branchToDelete"
}
alias gbdr='git-delete-remote-branch'
# Delete both local and remote branch (usage: gbdd branchNameToDeleteInLocalAndRemote)
git-delete-local-and-remote-branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: gbdd <branch-name-to-delete-in-local-and-remote>"
    return 1
  fi
  local branchToDelete=$1
  if [ "$branchToDelete" = "master" ] || [ "$branchToDelete" = "main" ]; then
    echo -e "ERROR: Cannot delete \033[1;31m$branchToDelete\033[0m"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  local didGitStash=false
  if [ "$currBranch" = "$branchToDelete" ]; then
    echo -e "\033[1;31mError: You cannot delete the branch you are currently on\033[0m"
    echo -e "Switching to \033[1;35m$(git_main_branch)\033[0m branch"
    git stash --include-untracked && didGitStash=true
    git checkout $(git_main_branch)
  fi
  git fetch --all --prune --tags --force > /dev/null 2>&1
  echo -en "Confirm DELETION of branch \033[1;31m$branchToDelete\033[0m in both \033[1;35mLOCAL\033[0m and \033[1;35mREMOTE\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]] && [[ ! "$response" =~ ^[yY]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  # if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
  if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
    echo -e "Branch deletion CANCELLED"
    return 1
  fi
  echo -e "DELETED branch \033[1;31m$branchToDelete\033[0m in both \033[1;35mLOCAL\033[0m and \033[1;35mREMOTE\033[0m"
  git branch -D "$branchToDelete" # 2>/dev/null
  git push origin --delete "$branchToDelete"
  if [ "$didGitStash" = true ]; then
    git stash pop
  fi
}
alias gbdd='git-delete-local-and-remote-branch'
# gcb newBranch && gco currBranch (used for git worktree workflow) [usage: gcbb newBranch]
gcbb() {
  if [ $# -ne 1 ]; then
    echo "Usage: gcbb <new-branch-name>"
    return 1
  fi
  local newBranch=$1
  if [ "$newBranch" = "$(git_main_branch)" ]; then
    echo -e "ERROR: Cannot create branch \033[1;31m$newBranch\033[0m; it is the default branch"
    return 1
  fi
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  if [ "$currBranch" = "$newBranch" ] || git show-ref --verify --quiet refs/heads/"$newBranch"; then
    echo -e "ERROR: Branch \033[1;31m$newBranch\033[0m already exists"
    return 1
  fi
  echo -e "Created branch: \033[1;35m$newBranch\033[0m"
  echo -e "Switched back to branch: \033[1;35m$currBranch\033[0m"
  git checkout -b "$newBranch" && git checkout "$currBranch"
}
gundo() {
  if [ $# -ne 1 ]; then
    echo "Usage: gundo <number-of-commits-to-rewind>"
    return 1
  fi
  if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo -e "\033[1;31mERROR: Input must a number > 0\033[0m"
    return 1
  fi
  # totalNumCommits=$(git rev-list --count HEAD)
  # if [ "$1" -gt "$totalNumCommits" ]; then
  #   echo -e "ERROR: Cannot undo \033[1;31m$1\033[0m commits (only \033[1;32m$totalNumCommits\033[0m commits exist)"
  #   return 1
  # fi
  echo -e "Running: \033[1;35mgit reset --mixed HEAD~$1$\033[0m"
  git reset --mixed HEAD~$1
}
git-reset-hard() {
  # if [ $# -gt 0 ]; then
  #   echo -en "Confirm \033[1;31mgit reset --hard $@\033[0m? [yes/N]: "
  # else
  #   echo -en "Confirm \033[1;31mgit reset --hard\033[0m? [yes/N]: "
  # fi
  echo -en "Confirm \033[1;31mgit reset --hard${@:+ $@}\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard CANCELLED"
    return 1
  fi
  if [ $# -eq 0 ]; then
    git reset --hard && git clean -fd
    return
  fi
  git reset --hard "$@"
}
alias grh='git-reset-hard'
git-reset-hard-and-git-clean() {
  # if [ $# -gt 0 ]; then
  #   echo -en "Confirm \033[1;31mgit reset --hard $@ && git clean -fd\033[0m? [yes/N]: "
  # else
  #   echo -en "Confirm \033[1;31mgit reset --hard && git clean -fd\033[0m? [yes/N]: "
  # fi
  echo -en "Confirm \033[1;31mgit reset --hard${@:+ $@} && git clean -fd\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard && git clean -fd CANCELLED"
    return 1
  fi
  if [ $# -eq 0 ]; then
    git reset --hard && git clean -fd
    return
  fi
  git reset --hard "$@" && git clean -fd
}
alias grh!='git-reset-hard-and-git-clean'
git-reset-hard-origin() {
  local currBranch=$(git_current_branch)
  echo -en "Confirm \033[1;31mgit reset --hard origin/$currBranch\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard origin/$currBranch CANCELLED"
    return 1
  fi
  git fetch --all --prune --tags --force && git reset --hard origin/$(git_current_branch)
}
alias grho='git-reset-hard-origin'
alias greset='git-reset-hard-origin'
git-reset-hard-origin-and-git-clean() {
  local currBranch=$(git_current_branch)
  echo -en "Confirm \033[1;31mgit reset --hard origin/$currBranch && git clean -fd\033[0m? [yes/N]: "
  read -r response
  # if [[ ! "$response" =~ ^[yY][eE][sS]$ ]]; then
  # if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  if [[ ! "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo -e "git reset --hard origin/$currBranch && git clean -fd CANCELLED"
    return 1
  fi
  git fetch --all --prune --tags --force && git reset --hard origin/$(git_current_branch) && git clean -fd
}
alias grho!='git-reset-hard-origin-and-git-clean'
alias greset!='git-reset-hard-origin-and-git-clean'
safe-git-stash-pop() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # echo -e "ERROR: \033[1;31m${PWD##*/}\033[0m is NOT a git repository, skipping"
    echo -e "ERROR: \033[1;31m$(basename "$PWD")\033[0m is NOT a git repository, skipping"
    return 1
  fi
  local dir=${1:-${PWD##*/}}
  # Try to apply stash without committing it
  if git stash show -p | git apply --check 2>/dev/null; then
    echo -e "\033[1;33mPopping from stash:\033[0m"
    for file in $(git stash show --name-only); do
      echo -e "\033[1;33m- Modified: $file\033[0m"
    done
    git stash pop >/dev/null 2>&1
  else
    echo -e "\033[1;33mWARNING: Stash conflicts detected in\033[0m \033[1;31m$dir\033[0m (use 'git stash show -p' to see changes && use 'git stash pop' when ready to merge)"
  fi
}
gl-repos() {
  for dir in */; do
    # [ -d "$dir" ] || continue
    if [ ! -d "$dir" ]; then
      continue
    fi
    # Strip trailing slash
    dir=${dir%/}
    # Wrap the operations for each directory within a subshell ( ... ) to safely isolate directory changes, eliminating the need to track and cd back to $startDir.
    (
      cd "$dir" || exit
      if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "Updating: \033[1;36m$dir\033[0m"
        local stashed=0
        if [ -n "$(git status --porcelain)" ]; then
          git stash --include-untracked >/dev/null 2>&1
          stashed=1
        fi
        git fetch --all --prune --tags --force >/dev/null 2>&1 && git pull --rebase --autostash
        if [ "$stashed" -eq 1 ]; then
          safe-git-stash-pop "$dir"
        fi
      else
        echo -e "\033[1;36m$dir\033[0m is NOT a git repository, skipping"
      fi
    )
    echo ""
  done
}
git-local-only-branches() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # echo -e "ERROR: \033[1;31m${PWD##*/}\033[0m is NOT a git repository" >&2
    echo -e "ERROR: \033[1;31m$(basename "$PWD")\033[0m is NOT a git repository" >&2
    return 1
  fi
  if ! git fetch --all --prune --tags --force >/dev/null 2>&1; then
    echo -e "ERROR: Failed to fetch updates from remote" >&2
    return 1
  fi
  echo -e "LOCAL branches with NO remote/upstream counterpart:"
  # Use awk to process formatted output:
  # - Branches with no upstream return 1 field (the branch name).
  # - Branches with a deleted upstream return 2 fields: "branch_name [gone]".
  git for-each-ref --sort=-committerdate --format='%(refname:short) %(upstream:track)' refs/heads/ | awk '{
    if (NF == 1 || $2 == "[gone]") {
      printf "  \033[1;35m%s\033[0m\n", $1
    }
  }'
}
alias gbl='git-local-only-branches'
alias gb-local-only='git-local-only-branches'
alias gb-norem='git-local-only-branches'
alias gb-no-remote='git-local-only-branches'
git-delete-branches-with-no-upstream() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi
  if ! git fetch --all --prune --tags --force &>/dev/null; then
    echo -e "ERROR: Failed to fetch updates from remote"
    return 1
  fi
  git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
    # Check if branch has no upstream
    if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then
      echo -n "Delete branch '\033[1;35m$branch\033[0m'? [y/N]: "
      read -r response
      if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
        echo -e "\033[1;31mDeleted: $branch\033[0m"
        git branch -D "$branch"
      else
        echo -e "\033[1;32mKept: $branch\033[0m"
      fi
    fi
  done
}
alias gbd-norem='git-delete-branches-with-no-upstream'
alias gbd-no-remote='git-delete-branches-with-no-upstream'
git-delete-branches--with-no-upstream-auto() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi
  if ! git fetch --all --prune --tags --force &>/dev/null; then
    echo -e "ERROR: Failed to fetch updates from remote"
    return 1
  fi
  git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do
    # Check if branch has no upstream
    if ! git rev-parse --verify "${branch}@{u}" >/dev/null 2>&1; then
      echo -e "\033[1;31mDeleted: $branch\033[0m"
      git branch -D "$branch"
    fi
  done
}
git-worktree-add() {
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT a git repository"
    return 1
  fi
  if [ $# -ne 2 ]; then
    echo "Usage:"
    echo -e "\033[1;32mgwta ../<target-branch-directory> <target-branch>\033[0m"
    return 1
  fi
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT the ROOT git repository"
    return 1
  fi
  local repoName=$(basename $(pwd))
  if [ -d "$1" ]; then
    echo -e "ERROR: Directory \033[1;31m$1\033[0m ALREADY exists"
    return 1
  fi
  if ! git rev-parse --verify "$2" >/dev/null 2>&1; then
    echo -e "ERROR: Branch \033[1;31m$2\033[0m does NOT exist"
    return 1
  fi
  echo -e "Created Git Worktree: \033[1;36m$1\033[0m on branch \033[1;35m$2\033[0m"
  git worktree add "$1" "$2"
}
alias gwta='git-worktree-add'
git-worktree-remove() {
  if [ $# -ne 1 ]; then
    echo "Usage: \033[1;32mgwtr ../<target-branch-directory>\033[0m"
    return 1
  fi
  # Special case: if $1 is exactly ".", remove the current worktree directory
  if [ "$1" = "." ]; then
    echo -e "\033[1;31mRemoved\033[0m Git Worktree: \033[1;31m$(basename $(pwd))\033[0m"
    git worktree remove -f .
    return 0
  fi
  if ! [ -d ".git" ]; then
    echo -e "ERROR: \033[1;31m$(basename $(pwd))\033[0m is NOT the ROOT git repository"
    return 1
  fi
  echo -e "\033[1;31mRemoved\033[0m Git Worktree: \033[1;31m$dirname\033[0m"
  git worktree remove -f "$dirname"
}
alias gwtr='git-worktree-remove'

