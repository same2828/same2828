# Change Java JDK version (usage: jdk 17)
jdk-change() {
  # if [ $# -ne 1 ]; then
  #   echo "Usage: jdk <java-jdk-version-to-use>"
  #   return 1
  # fi
  echo "------------------------------------------------------------"
  echo "Available Java JDK versions on this system:"
  echo "------------------------------------------------------------"
  /usr/libexec/java_home -V
  echo "------------------------------------------------------------"
  echo -en "Enter Java JDK version to use: "
  read -r response
  echo "------------------------------------------------------------"
  if [[ ! "$response" =~ ^[[:digit:]]{1,2}$ ]]; then
    echo -e "\033[1;31m ERROR: Enter a valid Java JDK version number (e.g., 8, 11, 17, 21)\033[0m"
    return 1
  fi
  echo -e "\033[1;32mSwitched to Java JDK: $response\033[0m";
  export JAVA_HOME=$(/usr/libexec/java_home -v $response)
  java -version
  echo "\$JAVA_HOME:" $JAVA_HOME
}
java-compile() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: j++ <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.java' if not present
  if [[ "$srcFile" != *.java ]]; then
    srcFile="${srcFile}.java"
  fi
  local fileName="${srcFile%.*}"
  local outputFile="$fileName.class"
  javac "$srcFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
}
alias j-compile='java-compile'
java-compile-run() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: j++ <source-file>"
    return 1
  fi
  local srcFile="$1"
  # Append '.java' if not present
  if [[ "$srcFile" != *.java ]]; then
    srcFile="${srcFile}.java"
  fi
  local fileName="${srcFile%.*}"
  local outputFile="$fileName.class"
  javac "$srcFile"
  echo -e "Compiled \033[1;32m$srcFile\033[0m to \033[1;32m$outputFile\033[0m"
  echo -e "Running \033[1;32mjava $fileName\033[0m"
  java "$fileName"
}
alias j-run='java-compile-run'
