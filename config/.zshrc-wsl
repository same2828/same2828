# FNM
#----
# export PATH="$HOME/.fnm:$PATH" # Only needed if fnm installed via CLI and NOT with Homebrew
eval "$(fnm env --use-on-cd --shell zsh)"
function fnm() {
  # Extends fnm with the subcommand "upgrade"
  # https://github.com/Schniz/fnm/issues/781#issuecomment-2482846772
  # if [[ "$1" =~ ^(upgrade|update)$ ]]; then
  if [[ $1 == "upgrade" || $1 == "update" ]]; then
    # Validate that $2 exists and is a valid version number
    if [[ -z "$2" ]]; then
      echo "Usage: fnm update <node-version>"
      return 1
    elif ! [[ "$2" =~ ^[0-9]{2}$ ]]; then
      echo "Error: Invalid version number '$2'. Version number needs to be 2 digits"
      return 1
    fi
    local major_node_version="$2"
    local latest_remote_node_version=$(command fnm ls-remote | grep "$major_node_version" | tail -n 1 | awk '{print $1}')
    local current_node_version=$(node -v)
    if [[ "$current_node_version" == "$latest_remote_node_version" ]]; then
      echo -e "\033[1;32mAlready using the latest Node.js $2.x version: $current_node_version\033[0m"
      return 0
    fi
    local matched_versions=()
    local pattern_match_version="* v$2"
    local pattern_match_system="* system $2"
    local is_system=0
    local line=""
    command fnm ls | while read LINE; do
      line=${LINE}
      if (( $line[(I)$pattern_match_version] )); then
        matched_versions+=${${${line#* v}%% *}%% default}
      fi
      if (( $line[(I)$pattern_match_system] )); then
        is_system=1
      fi
    done
    for version in $matched_versions; do
      command fnm uninstall $version
    done
    command fnm install "$2"
    command fnm default "$2"
    command fnm use "$2"
    if (( $is_system )); then
      echo "Re-alias system default version"
      command fnm alias system $2
    fi
  else
    command fnm "$@"
  fi
}

