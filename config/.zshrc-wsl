# Kubernetes
#-----------
alias k="kubectl"
alias kcx="kubectx"
alias kctx="kubectx"
alias kns="kubens"
kubectl-get-pods() {
  local context=$(kubectl config current-context)
  echo -e "context: \033[1;36m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "namespace: \033[1;36m$namespace\033[0m"
  kubectl get pods -n $namespace
}
alias kpo="kubectl-get-pods"
kubectl-get-pods-grep() {
  if [ $# -ne 1 ]; then
    echo "Usage: kpog <pod-name-to-grep>"
    return 1
  fi
  local context=$(kubectl config current-context)
  echo -e "context: \033[1;36m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "namespace: \033[1;36m$namespace\033[0m"
  kubectl get pods -n $namespace | grep -P --color=always "$1"
}
alias kpog="kubectl-get-pods-grep"
alias kgpo="kubectl-get-pods-grep"
kubectl-get-pods-watch() {
  kubectl get pods -n "$(kubectl config view --minify | grep namespace | cut -d" " -f6)" --watch
}
alias kpow="kubectl-get-pods-watch"
alias kgpow="kubectl-get-pods-watch"
kubectl-follow-pod-logs() {
  if [ $# -ne 1 ]; then
    echo "Usage: klo <pod-name-to-view-logs>"
    return 1
  fi
  kubectl logs -f "$1"
}
alias klo="kubectl-follow-pod-logs"
alias klof="kubectl-follow-pod-logs"
alias klog="kubectl-follow-pod-logs"
alias klogf="kubectl-follow-pod-logs"
alias klogs="kubectl-follow-pod-logs"
kx() {
  [ "$1" ] && kubectl config use-context "$1" || kubectl config current-context
}
kn() {
  [ "$1" ] && kubectl config set-context --current --namespace "$1" || kubectl config view --minify | grep namespace | cut -d" " -f6
}
