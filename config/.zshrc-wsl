# Docker
#-------
# Docker container management
alias d="docker"
alias dps="docker ps"
alias dpsa="docker ps -a"
# alias dstop="docker stop -t0"
alias d-start="docker start"
alias d-restart="docker restart -t0"
# alias drm="docker rm -f"
alias d-exec="docker exec -it"
# alias dlogs="docker logs -f"
alias d-inspect="docker inspect"
# Stop all running containers
d-stop-all-ctnrs() {
  docker ps -aq | xargs -r docker stop --signal=9 -t0
}
d-rm-all-ctnrs() {
  # docker rm -f $(docker ps -aq)
  docker ps -aq | xargs -r docker rm -f
}
alias dclean="d-rm-all-ctnrs"
d-stop-rm-all-ctnrs() {
  docker ps -aq | xargs -r docker stop --signal=9 -t0
  docker ps -aq | xargs -r docker rm -f
}
# Remove all dangling (unused) images
d-rmi-dangling() {
  docker images -qf dangling=true | xargs -r docker rmi -f
}
# Remove all dangling (unused) volumes
d-rmv-dangling() {
  docker volume ls -qf dangling=true | xargs -r docker volume rm -f
}
d-sh() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: dsh <container-name-or-id>"
    return 1
  fi
  # docker exec -it "$1" "/usr/bin/env bash"
  docker ps -a | grep -iP "$1" | head -n 1 | awk '{print $1}' | xargs docker exec -it "$1" "/usr/bin/env bash"
}
# Follow logs of a container
d-logs() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: dlogs <regex-pattern-of-cntr>"
    return 1
  fi
  # docker logs -f "$1"
  docker ps -a | grep -iP "$1" | head -n 1 | awk '{print $1}' | xargs docker logs -f
}
alias dlo="dlogs"
# Function to stop containers matching a name pattern
d-stop-grep() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: docker-stop-grep <regex-pattern-of-cntr>"
    return 1
  fi
  docker ps -a | grep -iP "$1" | awk '{print $1}' | xargs -r docker stop --signal=9 -t0
}
alias d-stop="d-stop-grep"
# Function to remove containers matching a name pattern
d-rm-grep() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: docker-rm-grep <regex-pattern-of-cntr>"
    return 1
  fi
  docker ps -a | grep -iP "$1" | awk '{print $1}' | xargs -r docker rm -f
}
alias d-rm="docker-rm-grep"
# Get container IP address
d-ip() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: dip <regex-pattern-of-cntr>"
    return 1
  fi
  # docker inspect --format '{{ .NetworkSettings.IPAddress }}' "$1"
  docker ps -a | grep -iP "$1" |  head -n 1 | awk '{print $1}' | xargs docker inspect --format '{{ .NetworkSettings.IPAddress }}'
}
# Docker Images
# alias d-rmi="docker rmi -f"
alias d-images="docker images"
alias d-pull="docker pull"
alias d-build="docker build"
alias d-tag="docker tag"
# Function to remove images matching a name pattern
docker-rmi-grep() {
  if [ $# -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: docker-rmi-grep <regex-pattern-of-image>"
    return 1
  fi
  docker images | grep -iP "$1" | awk '{print $1}' | xargs -r docker rmi -f
}
alias d-rmi="docker-rmi-grep"
# Docker Volumes and Networks
alias d-vls="docker volume ls"
alias d-vrm="docker volume rm -f"
alias d-nls="docker network ls"
alias d-nrm="docker network rm -f"
# Docker Ccleanup
alias d-prune="docker system prune -f"
alias d-prune!="docker system prune -af --volumes"
# Docker Compose
alias dc="docker compose"
alias dc-build="docker compose build"
alias dc-down="docker compose down -t0"
alias dc-exec="docker compose exec"
alias dc-logs="docker compose logs"
alias dc-ps="docker compose ps"
alias dc-pull="docker compose pull"
alias dc-restart="docker compose restart -t0"
alias dc-start="docker compose start"
alias dc-stop="docker compose stop -t0"
alias dc-up="docker compose up"
alias dc-upd="docker compose up -d"
docker-compose-logs-follow() {
  if [ -z "$1" ]; then
    docker compose logs -f
  else
    docker compose logs -f "$1"
  fi
}
alias dclo="docker-compose-logs-follow"

# Kubernetes
#-----------
alias k="kubectl"
alias kcx="kubectx"
alias kctx="kubectx"
alias kns="kubens"
k-info() {
  local context=$(kubectl config current-context)
  echo -e "Context: \033[1;35m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "Namespace: \033[1;35m$namespace\033[0m"
}
alias kinfo="k-info"
k-get-pods() {
  local context=$(kubectl config current-context)
  echo -e "Context: \033[1;35m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "Namespace: \033[1;35m$namespace\033[0m"
  kubectl get pods -n $namespace
}
alias kpo="k-get-pods"
k-get-pods-grep() {
  if [ $# -ne 1 ]; then
    echo "Usage: kpog <pod-name-to-grep>"
    return 1
  fi
  local context=$(kubectl config current-context)
  echo -e "Context: \033[1;35m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "Namespace: \033[1;35m$namespace\033[0m"
  kubectl get pods -n $namespace | grep --color=always -iP "$1"
}
alias kpog="k-get-pods-grep"
k-get-pods-watch() {
  local context=$(kubectl config current-context)
  echo -e "Context: \033[1;35m$context\033[0m"
  local namespace=$(kubectl config view --minify | grep namespace | cut -d" " -f6)
  echo -e "Namespace: \033[1;35m$namespace\033[0m"
  kubectl get pods -n "$(kubectl config view --minify | grep namespace | cut -d" " -f6)" --watch
}
alias kpow="k-get-pods-watch"
k-describe-pod() {
  if [ $# -ne 1 ]; then
    echo "Usage: kdpo <pod-name-to-describe>"
    return 1
  fi
  kubectl describe pod "$1"
}
alias kdo="k-describe-pod"
alias kdp="k-describe-pod"
k-follow-pod-logs() {
  if [ $# -ne 1 ]; then
    echo "Usage: klo <pod-name-to-view-logs>"
    return 1
  fi
  kubectl logs -f "$1"
}
alias klo="kubectl-follow-pod-logs"
