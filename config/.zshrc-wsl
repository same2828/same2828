# Maven
#------
mvnn() {
  local skip_test_compile=""
  local skip_test_run=""
  local response=""
  local RED='\033[1;31m'
  local GREEN='\033[1;32m'
  local RESET='\033[0m'
  echo -n -e "${RED}Skip Test COMPILATION? [y/N]: ${RESET}"
  read response
  if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    skip_test_compile="-Dmaven.test.skip=true"
  else
    echo -n -e "${RED}Skip Test EXECUTION? [y/N]: ${RESET}"
    read response
    if [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]; then
      skip_test_run="-DskipTests"
    fi
  fi
  # Construct and run the command
  # Use array for better argument handling in zsh
  local -a mvn_args
  mvn_args=(clean install -U)
  [[ -n "$skip_test_compile" ]] && mvn_args+=("$skip_test_compile")
  [[ -n "$skip_test_run" ]] && mvn_args+=("$skip_test_run")

  echo -e "${GREEN}Running: mvn ${mvn_args[*]}${RESET}"
  command mvn "${mvn_args[@]}"
}
alias mvn--='mvn clean install -DskipTests'
alias mvn++='mvn clean install -U -DskipTests' # Compiles test classes but skips test execution
alias mvn++!='mvn clean install -U -Dmaven.test.skip=true' # Skips test compilation and test execution
alias mvn-compile='mvn clean install -U -DskipTests'
alias mvn-install='mvn clean install -U'
alias mvn-dependency-tree='mvn dependency:tree -Dverbose'
alias mvn-tree='mvn dependency:tree -Dverbose'
alias mvn-pom='mvn help:effective-pom -Dverbose=true'
alias mvn-effective-pom='mvn help:effective-pom -Dverbose=true'
alias mvn-display-dependency-updates='mvn versions:display-dependency-updates'
alias mvn-display-property-updates='mvn versions:display-property-updates'
# alias mvn-run='mvn spring-boot:run -Dspring-boot.run.arguments=--debug -Dspring-boot.run.profiles=local'
mvn-run() {
  local profile="${1:-local}"
  mvn spring-boot:run -Dspring-boot.run.arguments=--debug -Dspring-boot.run.profiles="$profile"
}
