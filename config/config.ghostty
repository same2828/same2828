# /Users/${USER}/Library/Application Support/com.mitchellh.ghostty/config.ghostty
adjust-cell-height = 10%
adjust-cursor-thickness = 40%
auto-update = check
auto-update-channel = stable
background = #000000
background-blur = false
background-opacity = 1
bell-audio-volume = 0
confirm-close-surface = false
cursor-color = #FFFFFF
cursor-style = bar
cursor-style-blink = false
desktop-notifications = false
font-family = "JetBrainsMonoNLZ"
font-family-bold = "JetBrainsMonoNLZ"
font-family-bold-italic = "JetBrainsMonoNLZ"
font-family-italic = "JetBrainsMonoNLZ"
font-size = 16
font-style = Bold
font-style-bold = Bold
font-style-bold-italic = Bold
font-style-italic = Bold
font-thicken = true
font-thicken-strength = 50
link-previews = false
linux-cgroup-memory-limit = 1000000000
macos-icon = chalkboard
macos-option-as-alt = true
macos-titlebar-style = native
palette = 0=#000000
palette = 1=#FF0000
palette = 10=#00F900
palette = 11=#FFFB00
palette = 12=#BD93F9
palette = 13=#FF40FF
palette = 14=#00FDFF
palette = 15=#FFFFFF
palette = 2=#00F900
palette = 3=#FFFB00
palette = 4=#BD93F9
palette = 5=#FF40FF
palette = 6=#00FDFF
palette = 7=#FFFFFF
palette = 8=#000000
palette = 9=#FF0000
selection-background = #B3D7FF
split-inherit-working-directory = false
tab-inherit-working-directory = false
window-height = 22
window-inherit-working-directory = false
window-new-tab-position = end
window-padding-balance = true
window-show-tab-bar = always
window-width = 90
working-directory = ~/dev/github