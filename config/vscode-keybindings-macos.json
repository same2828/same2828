// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "command": "workbench.action.files.saveWithoutFormatting",
    "key": "cmd+s"
  },
  {
    "command": "-workbench.action.files.saveWithoutFormatting",
    "key": "cmd+k s"
  },
  {
    "command": "workbench.action.files.save",
    "key": "alt+s"
  },
  {
    "command": "-workbench.action.files.save",
    "key": "cmd+s"
  },
  {
    "command": "-tabnine.accept-inline-suggestion",
    "key": "tab",
    "when": "tabnine.in-inline-suggestions && tabnine.inline-suggestion:enabled || tabnine.in-inline-suggestions && tabnine.snippet-suggestion:enabled"
  },
  {
    "command": "workbench.explorer.fileView.focus",
    "key": "cmd+k f"
  },
  {
    "command": "-workbench.action.closeFolder",
    "key": "cmd+k f",
    "when": "emptyWorkspaceSupport && workbenchState != 'empty'"
  },
  {
    "command": "explorer.newFile",
    "key": "cmd+n",
    "when": "explorerViewletFocus"
  },
  {
    "command": "explorer.newFolder",
    "key": "cmd+shift+n",
    "when": "explorerViewletFocus"
  },
  {
    "command": "redo",
    "key": "cmd+y"
  },
  {
    "command": "-redo",
    "key": "shift+cmd+z"
  },
  {
    "command": "-rerunSearchEditorSearch",
    "key": "shift+cmd+r",
    "when": "inSearchEditor"
  },
  {
    "command": "revealFileInOS",
    "key": "shift+cmd+r", // external keyboard: "shift+alt+r", internal keyboard: "shift+cmd+r"
    "when": "!editorFocus"
  },
  {
    "command": "-revealFileInOS",
    "key": "alt+cmd+r",
    "when": "!editorFocus"
  },
  {
    "command": "workbench.action.files.revealActiveFileInWindows",
    "key": "shift+cmd+r"
  },
  {
    "command": "-workbench.action.files.revealActiveFileInWindows",
    "key": "cmd+k r"
  },
  {
    "command": "renameFile",
    "key": "shift+enter",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "command": "-renameFile",
    "key": "enter",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "command": "explorer.openAndPassFocus",
    "key": "enter",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "command": "-explorer.openAndPassFocus",
    "key": "cmd+down",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "command": "editor.action.formatDocument",
    "key": "alt+a",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "command": "-editor.action.formatDocument",
    "key": "shift+alt+f",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "command": "markdown.extension.editing.toggleStrikethrough",
    "key": "shift+alt+s",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "command": "-markdown.extension.editing.toggleStrikethrough",
    "key": "alt+s",
    "when": "false"
  },
  {
    "command": "markdown.extension.checkTaskList",
    "key": "alt+c",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "command": "-markdown.extension.checkTaskList",
    "key": "alt+c",
    "when": "false"
  },
  {
    "command": "-markdown.extension.onShiftEnterKey",
    "key": "shift+enter",
    "when": "editorTextFocus && !editorHasMultipleSelections && !editorReadonly && !markdown.extension.editor.cursor.inFencedCodeBlock && !markdown.extension.editor.cursor.inMathEnv && !suggestWidgetVisible && editorLangId =~ /^markdown$|^rmd$|^quarto$/ || editorTextFocus && !editorHasMultipleSelections && !editorReadonly && !markdown.extension.editor.cursor.inFencedCodeBlock && !markdown.extension.editor.cursor.inMathEnv && config.editor.acceptSuggestionOnEnter == 'off' && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "command": "-workbench.action.chat.openEditSession",
    "key": "shift+cmd+i",
    "when": "chatEditingParticipantRegistered && chatIsEnabled && view != 'workbench.panel.chat.view.edits'"
  },
  {
    "command": "-workbench.action.chat.open",
    "key": "ctrl+cmd+i",
    "when": "chatPanelParticipantRegistered"
  },
  {
    "command": "workbench.action.chat.open",
    "key": "shift+cmd+i"
  },
  {
    "command": "bookmarks.toggleLabeled",
    "key": "alt+cmd+i",
    "when": "editorTextFocus"
  },
  {
    "command": "workbench.action.quickOpen",
    "key": "shift shift"
  },
  {
    "command": "-github.copilot.generate",
    "key": "ctrl+enter",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "command": "github.copilot.generate",
    "key": "ctrl+alt+enter",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "command": "-workbench.action.chat.applyInEditor",
    "key": "ctrl+enter",
    "when": "accessibleViewInCodeBlock && chatIsEnabled || chatIsEnabled && inChat && !inChatInput"
  },
  {
    "command": "-workbench.action.chat.insertCodeBlock",
    "key": "ctrl+enter",
    "when": "accessibleViewInCodeBlock && chatIsEnabled || chatIsEnabled && inChat && !inChatInput"
  },
  {
    "command": "-workbench.action.chat.runInTerminal",
    "key": "ctrl+alt+enter",
    "when": "accessibleViewInCodeBlock && chatIsEnabled || chatIsEnabled && inChat"
  }
]