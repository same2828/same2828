# zsh-autosuggestions
#--------------------
# ctrl + j = toggle zsh-autosuggestions on/off
bindkey '^j' autosuggest-toggle
bindkey '^k' toggle-fzf-tab
# Enforce < 81 character limit
ZSH_AUTOSUGGEST_HISTORY_IGNORE="(?(#c81,)|*gcmsg '*|*gcmsg \"*|(brew (install|uninstall|info|tap)|cat|cd|codium|curl|echo|fetch|git (add|branch|checkout|clone|merge|rebase|remote)|ga|gc|gca|gcam|gcas|gcasm|gcb|gcl|gcmsg|gco|gcs|gcsm|git commit -(am|m)|mkdir|mv|npm (install|uninstall|link|unlink)|npx|pnpm (add|remove|install|uninstall|link|unlink|up|update|upgrade)|sh|wget|yarn (add|remove|link|unlink|up)|youtube-dl) *)"

