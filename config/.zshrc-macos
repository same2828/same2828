alias brew-outdated-cask="brew update > /dev/null 2>&1 && brew outdated --cask --greedy"
alias brew-outdated="brew update > /dev/null 2>&1 && brew outdated --greedy"
alias brew-update="brew update > /dev/null 2>&1 && brew outdated --greedy"
alias cls="clear"
alias cude="codium"
alias egrep="egrep --color=always"
alias fgrep="fgrep --color=always"
alias g++="g++-13"
alias gcc="gcc-13"
alias grep='grep --color=always'
alias ll='ls -AoF --color=auto'
alias ls='ls --color=auto'
alias lsd='ls -d */'
alias rezsh='source ~/.zshrc'
alias untar="tar -xvf"
