FD_OPTIONS="--strip-cwd-prefix --follow --exclude={'**/.*OneDrive*','**/.android','**/.aws','**/.azure','**/.backup*','**/.bin*','**/.boto','**/.brew','**/.build','**/.bundle','**/.cache*','**/.cfg','**/.CFUserTextEncoding*','**/.classpath','**/.codeium','**/.conf','**/.config','**/.cups','**/.dbus','**/.dist*','**/.docker','**/.dotnet','**/.DS_Store','**/.dump*','**/.editorconfig','**/.eggs','**/.env','**/.factorypath','**/.firebase','**/.font*','**/.git','**/.gitflow*','**/.gradle','**/.hg*','**/.history','**/.homebrew','**/.hushlogin','**/.icloud','**/.idea*','**/.kube/cache','**/.landscape','**/.lemminx','**/.lesshst','**/.linuxbrew','**/.local','**/.localized','**/.m2','**/.matplotlib','**/.mounty','**/.next','**/.node_modules*','**/.node*','**/.nox','**/.npm*','**/.nvm*','**/.oh-my-zsh','**/.out','**/.output','**/.pnpm*','**/.postman','**/.project','**/.python*','**/.settings','**/.sf','**/.sts*','**/.svn','**/.target','**/.temp*','**/.temporary*','**/.temurin*','**/.tldrc','**/.tmp*','**/.tox','**/.trash*','**/.Trash*','**/.venv','**/.vercel','**/.vnc','**/.vol','**/.vscode*','**/.webpack*','**/.yarn*','**/.zcompdump*','**/.zprofile?*','**/.zsh_sessions*','**/.zshrc?*','**/*OneDrive*','**/3D Objects','**/AppData','**/Application*','**/backup*','**/Backup*','**/bin','**/boot','**/build.*','**/build*','**/Build*','**/cache*','**/Cache*','**/certs','**/Certs','**/Chrome Download','**/Chrome*','**/Contacts','**/cores','**/cvmfs','**/CVS','**/Default','**/Desktop','**/dist','**/Documents','**/Drop*Box','**/dump*','**/eggs','**/env','**/etc','**/External*','**/favorite*','**/Favorite*','**/favourite*','**/Favourite*','**/font*','**/Font*','**/Game*','**/history*','**/History*','**/home/(!s3same)','**/home/(!s3same)','**/home/(!s3samedev)','**/home/(!same)','**/htmlcov','**/Idm','**/IDM','**/image*','**/Image*','**/img*','**/InstallArea','**/Intel','**/Lecture*','**/lib','**/Lib','**/lib64','**/Libraries','**/Library*','**/Link*','**/media','**/Media','**/mnt','**/Movies','**/Mp3tag','**/Music','**/node_modules*','**/NVIDIA*','**/opt','**/out','**/output','**/People','**/PerfLogs','**/Personal','**/photo*','**/Photo*','**/pic*','**/Pic*','**/picture*','**/Picture*','**/Postman','**/prebundle','**/private','**/proc','**/Program Files (x86)','**/Program Files','**/ProgramData','**/Public','**/root','**/Root','**/run','**/Saved Games','**/sbin','**/Screenshot*','**/sdist','**/Search*','**/Shared*','**/Sharing*','**/srv','**/Standard Notes*','**/standardnotes*','**/Steam','**/sys','**/System*','**/target.*','**/target*','**/Target*','**/temp*','**/Temp*','**/Thumbs.db','**/tmp*','**/Tmp*','**/Tool*','**/torrent*','**/Torrent*','**/usr','**/Utilities','**/Utility','**/var','**/venv','**/vid*','**/Vid*','**/video*','**/Video*','**/vod*','**/Vod*','**/volumes','**/Volumes','**/vscode*','**/wheels','**/Windows'}"
