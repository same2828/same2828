alias cls="clear"
alias cpuhogs='ps wwaxr -o pid,stat,%cpu,%mem,time,command | head -10' # Show Top 10 CPU Hogs
alias cude="codium"
alias g++="g++-13"
alias gcc="gcc-13"
alias gclean='git reset --hard && git clean -dfx'
alias gcleano='git fetch --all --prune && git reset --hard origin/$(git_current_branch) && git clean -dfx'
alias gcmsg!='git commit --amend -m'
alias gf='git fetch --all --prune'
alias gl="git pull --rebase --autostash"
alias glo="git log --pretty='%C(yellow)%h %C(cyan)%cd %C(red)%aN %Creset%s%C(green)%d' --date=format:'%d/%m/%y %I:%M%p'"
alias glo2="git log --graph --oneline --decorate --pretty='%C(yellow)%h %C(cyan)%cd %C(red)%aN %Creset%s%C(green)%d' --date=format:'%d/%m/%y %I:%M%p'"
alias glo3="git log --pretty='%C(yellow)%h %C(cyan)%cd %C(magenta)%aN %Creset%s%C(green)%d' --date=format:'%d/%m/%y %I:%M:%S%p'"
alias grep='grep --color=always'
alias gstash='git stash --all'
alias gstashp='git stash pop'
alias gsth='git stash --all'
alias gstp='git stash pop'
alias gstsh='git stash --all'
alias gstshp='git stash pop'
alias gundo='git reset --mixed HEAD~1'
alias gwta='git worktree add' # cd myRepo && gwta ../targetBranchDir targetBranch
alias gwtl='git worktree list'
alias gwtr='git worktree remove' # cd myRepo && gwtr ../targetBranchDir || cd targetBranchDir && gwtr .
alias ll='ls -AoF --color=auto'
# alias ll='ls -AlF --color=auto'
alias ls='ls --color=auto'
alias lsd='ls -d */'
alias memhogs='ps wwaxm -o pid,stat,vsize,rss,time,command | head -10' # Show Top 10 Memory Hogs
alias rezsh='source ~/.zshrc'
alias untar="tar -xvf"

# Custom Functions
# ----------------
# List processes that are using a port (usage: findport 3000) [note: the name should be findprocess but findport is faster to type]
findport() {
  lsof -i :$1
}
# Kill a process that is using a port (usage: killport 3000) [note: the name should be killprocess but killport is faster to type]
killport() {
  kill -9 $(lsof -t -i:$1)
}
# Show All Processes Owned By User (usage: mine)
mine() {
  # ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,bsdtime,command --sort=-%cpu # Note: --sort=-%cpu does NOT work on macOS
  ps "$@" -u "${USER}" -o pid,%cpu,%mem,start,time,bsdtime,command
}
# Create directory and cd into it (usage: mkcd dirName)
mkcd() {
  mkdir -p "$@"
  cd "$@"
}
# Open Project with IntelliJ (usage: idea .)
idea() {
  open -a "IntelliJ IDEA CE" "$1"
}
# OhMyZSH Override
git_main_branch() {
  echo master
}
# Upgrade Brew Casks
brew-upgrade-casks() {
  brew upgrade --cask $(brew list --cask)
}
# Upgrade zsh plugins
zsh-upgrade-plugins() {
  for dir in "$ZSH/custom/plugins"/*; do
    if [ -d "$dir/.git" ]; then
      echo "Updating repository in $dir"
      cd "$dir"
      git pull
      # cd - > /dev/null
    else
      echo "$dir is not a git repository"
    fi
  done
  cd
}
# Change Java JDK version
jdk() {
  echo "Switching Java JDK to: $1";
  export JAVA_HOME=$(/usr/libexec/java_home -v $1)
  echo "\$JAVA_HOME:" $JAVA_HOME
  echo "\$(java -version):"
  echo "------------------"
  java -version
  echo "------------------"
}
# gcb newBranch && gco currBranch
gcbo() {
  if [ $# -ne 1 ]; then
    echo "Usage: gcbo <new-branch-name>"
    return 1
  fi
  local newBranch=$1
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  git checkout -b "$newBranch" && git checkout "$currBranch"
}
# gcb newBranch && gco currBranch
gcbb() {
  if [ $# -ne 1 ]; then
    echo "Usage: gcbb <new-branch-name>"
    return 1
  fi
  local newBranch=$1
  # local currBranch=$(git rev-parse --abbrev-ref HEAD)
  local currBranch=$(git_current_branch)
  git checkout -b "$newBranch" && git checkout "$currBranch"
}
